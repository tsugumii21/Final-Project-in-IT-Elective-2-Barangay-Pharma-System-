@model IEnumerable<BarangayPharmaSystem.Areas.Patient.Models.PatientDispensingListViewModel>
@{
    ViewData["Title"] = "My Dispensing History";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0 text-gray-800">My Dispensing History</h1>
</div>

<div class="card shadow-sm border-0 rounded mb-4" style="border-top: 4px solid #1A6FA3 !important;">
    <div class="card-header py-3 bg-white border-bottom d-flex flex-row align-items-center justify-content-between">
        <h6 class="m-0 font-weight-bold" style="color: #1A6FA3;">History Log</h6>
        <form method="get" asp-action="Index" class="row g-2 align-items-end w-100">
            <div class="col-auto">
                <label class="form-label small text-muted mb-1">From:</label>
                <input type="date" name="startDate" value="@ViewData["StartDate"]"
                       class="form-control form-control-sm bg-light" />
            </div>
            <div class="col-auto">
                <label class="form-label small text-muted mb-1">To:</label>
                <input type="date" name="endDate" value="@ViewData["EndDate"]"
                       class="form-control form-control-sm bg-light" />
            </div>
            <div class="col-auto d-flex gap-2">
                <button class="btn btn-sm btn-primary" type="submit"
                        style="background-color:var(--bps-primary); border-color:var(--bps-primary);">
                    <i class="bi bi-funnel-fill me-1"></i>Filter
                </button>
                @if (ViewData["StartDate"] != null || ViewData["EndDate"] != null)
                {
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Clear</a>
                }
            </div>
        </form>

    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0" width="100%" cellspacing="0">
                <thead class="bg-light">
                    <tr>
                        <th class="border-top-0">Date & Time</th>
                        <th class="border-top-0">Medicine</th>
                        <th class="border-top-0 text-center">Quantity Dispensed</th>
                        <th class="border-top-0">Dispensed By (Staff)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="align-middle text-muted">@item.DateDispensed.ToLocalTime().ToString("MMM dd, yyyy hh:mm tt")</td>
                            <td class="align-middle font-weight-bold" style="color: #1A6FA3;">@item.MedicineName</td>
                            <td class="align-middle text-center">
                                <span class="badge bps-badge-completed px-3 py-2" style="font-size: 1rem;">@item.QuantityDispensed</span>
                            </td>
                            <td class="align-middle text-muted">@item.StaffName</td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                <i class="fas fa-pills fa-3x mb-3 text-light"></i><br/>
                                No dispensing records found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
