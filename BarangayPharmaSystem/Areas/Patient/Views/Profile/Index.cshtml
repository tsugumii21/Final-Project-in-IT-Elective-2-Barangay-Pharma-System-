@model BarangayPharmaSystem.Areas.Patient.Models.PatientProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0 text-gray-800">My Profile</h1>
</div>

<div class="row">
    <!-- Read-Only Info -->
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 rounded mb-4" style="border-top: 4px solid #1A6FA3 !important;">
            <div class="card-header py-3 bg-white border-bottom">
                <h6 class="m-0 font-weight-bold" style="color: #1A6FA3;">Personal Information</h6>
            </div>
            <div class="card-body p-4">
                <div class="alert alert-info border-0 rounded mb-4" style="background-color: #EAF4FB; color: #1A6FA3;">
                    <i class="fas fa-info-circle mr-2"></i> 
                    <strong>Notice:</strong> For security and medical accuracy, core health records cannot be edited directly. 
                    If you need to change your name, address, or birthdate, please contact the Pharmacy Staff.
                </div>

                <div class="row mb-3">
                    <div class="col-sm-4 text-muted font-weight-bold">Patient ID</div>
                    <div class="col-sm-8 font-weight-bold text-primary" style="letter-spacing: 1px;">@Model.PatientCode</div>
                </div>
                <hr>
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted font-weight-bold">Full Name</div>
                    <div class="col-sm-8">@Model.FullName</div>
                </div>
                <hr>
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted font-weight-bold">Birthdate</div>
                    <div class="col-sm-8">@Model.Birthdate.ToString("MMMM dd, yyyy")</div>
                </div>
                <hr>
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted font-weight-bold">Contact Number</div>
                    <div class="col-sm-8">@(string.IsNullOrEmpty(Model.ContactNumber) ? "Not Provided" : Model.ContactNumber)</div>
                </div>
                <hr>
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted font-weight-bold">Address</div>
                    <div class="col-sm-8">@Model.Address</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Photo Upload -->
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 rounded mb-4 text-center p-4">
            <div class="mb-4">
                @if (!string.IsNullOrEmpty(Model.CurrentPhotoPath))
                {
                    <img src="~/@Model.CurrentPhotoPath" alt="Profile Photo" class="rounded-circle shadow-sm" style="width: 150px; height: 150px; object-fit: cover; border: 4px solid #EAF4FB;" />
                }
                else
                {
                    <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center text-white mx-auto shadow-sm" style="width: 150px; height: 150px; border: 4px solid #EAF4FB;">
                        <i class="fas fa-user fa-4x"></i>
                    </div>
                }
            </div>

            <h5 class="font-weight-bold text-gray-800 mb-3">Profile Photo</h5>
            
            <form asp-action="UpdatePhoto" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="Id" />
                <div class="form-group mb-3 text-left">
                    <div class="custom-file">
                        <input asp-for="PhotoFile" class="custom-file-input" id="customFile" accept="image/jpeg,image/png" required>
                        <label class="custom-file-label" for="customFile">Choose file...</label>
                    </div>
                    <small class="form-text text-muted mt-2">Max size: 2MB. Only .jpg and .png are allowed.</small>
                </div>
                <button type="submit" class="btn btn-primary btn-block shadow-sm" style="background-color: #1A6FA3; border-color: #1A6FA3;">
                    <i class="fas fa-upload mr-2"></i> Update Photo
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $('.custom-file-input').on('change', function() {
            var fileName = $(this).val().split('\\').pop();
            $(this).next('.custom-file-label').addClass("selected").html(fileName);
        });
    </script>
}
