@model BarangayPharmaSystem.Areas.Patient.Models.PatientProfileViewModel
@{
    ViewData["Title"] = "My Profile";
    ViewData["PageTitle"] = "My Profile";
    // Derive initials for the avatar placeholder
    var nameParts = (Model.FullName ?? "P").Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initials  = nameParts.Length >= 2
        ? $"{nameParts[0][0]}{nameParts[^1][0]}"
        : nameParts[0][0].ToString();
}

<!-- Page Header -->
<div class="bps-page-header">
    <div>
        <h1 class="bps-page-title">My Profile</h1>
        <p class="bps-page-subtitle">View your personal health record details</p>
    </div>
</div>

<div class="row g-4">

    <!-- ── Left: Personal Information ──────────────────────────────── -->
    <div class="col-lg-7">
        <div class="bps-card h-100">
            <div class="bps-card-header" style="border-top: 4px solid var(--bps-primary);">
                <h3 class="bps-card-title">
                    <i class="bi bi-person-lines-fill text-primary me-2"></i>Personal Information
                </h3>
            </div>
            <div class="bps-card-body p-4">

                <!-- Notice box -->
                <div class="d-flex align-items-start gap-3 p-3 mb-4 rounded-3"
                     style="background: var(--bps-primary-subtle); border: 1px solid rgba(26,111,163,0.2);">
                    <i class="bi bi-info-circle-fill mt-1" style="color: var(--bps-primary); font-size: 1.1rem; flex-shrink:0;"></i>
                    <div style="font-size: 0.875rem; color: var(--bps-gray-700); line-height: 1.6;">
                        <strong>Notice:</strong> For security and medical accuracy, core health records cannot be
                        edited directly. Contact the Pharmacy Staff to update your name, address, or birthdate.
                    </div>
                </div>

                <!-- Patient ID badge -->
                <div class="d-flex align-items-center gap-3 mb-4 p-3 rounded-3"
                     style="background: var(--bps-gray-50); border: 1px solid var(--bps-gray-200);">
                    <div>
                        <div class="text-muted" style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em;">Patient ID</div>
                        <div class="fw-bold" style="font-size: 1.125rem; letter-spacing: 0.08em; color: var(--bps-primary); font-family: monospace;">
                            @Model.PatientCode
                        </div>
                    </div>
                    <span class="ms-auto badge rounded-pill"
                          style="background: var(--bps-primary-subtle); color: var(--bps-primary); font-size: 0.75rem; padding: 0.4em 0.9em;">
                        Verified Patient
                    </span>
                </div>

                <!-- Info rows -->
                @{
                    var fields = new[]
                    {
                        ("bi-person-fill",        "Full Name",        Model.FullName ?? "—"),
                        ("bi-calendar-fill",      "Birthdate",        Model.Birthdate.ToString("MMMM dd, yyyy")),
                        ("bi-telephone-fill",     "Contact Number",   string.IsNullOrEmpty(Model.ContactNumber) ? "Not Provided" : Model.ContactNumber),
                        ("bi-geo-alt-fill",       "Address",          Model.Address ?? "—"),
                    };
                }
                <div style="display: flex; flex-direction: column; gap: 0;">
                    @foreach (var (icon, label, value) in fields)
                    {
                        <div class="d-flex align-items-start gap-3 py-3"
                             style="border-bottom: 1px solid var(--bps-gray-100);">
                            <div style="width:32px; height:32px; background:var(--bps-primary-subtle); border-radius:50%; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                                <i class="bi @icon" style="color:var(--bps-primary); font-size:0.875rem;"></i>
                            </div>
                            <div>
                                <div class="text-muted" style="font-size:0.75rem; font-weight:700; text-transform:uppercase; letter-spacing:0.05em;">@label</div>
                                <div style="font-size:0.9375rem; color:var(--bps-gray-800); margin-top:0.125rem;">@value</div>
                            </div>
                        </div>
                    }
                </div>

            </div>
        </div>
    </div>

    <!-- ── Right: Profile Photo ─────────────────────────────────────── -->
    <div class="col-lg-5">
        <div class="bps-card h-100 text-center">
            <div class="bps-card-header" style="border-top: 4px solid var(--bps-accent);">
                <h3 class="bps-card-title">
                    <i class="bi bi-camera-fill text-primary me-2"></i>Profile Photo
                </h3>
            </div>
            <div class="bps-card-body p-4">

                <!-- Photo or initials avatar -->
                <div class="d-flex justify-content-center mb-4">
                    @if (!string.IsNullOrWhiteSpace(Model.CurrentPhotoPath))
                    {
                        <img src="@Model.CurrentPhotoPath"
                             alt="@Model.FullName"
                             class="bps-profile-photo"
                             style="width:120px; height:120px; border-radius:50%; object-fit:cover; border:4px solid var(--bps-primary-subtle); box-shadow: 0 4px 16px rgba(0,0,0,0.12);" />
                    }
                    else
                    {
                        <div style="width:120px; height:120px; border-radius:50%; background:var(--bps-primary); color:#fff;
                                    display:flex; align-items:center; justify-content:center;
                                    font-family:var(--bps-font-heading); font-size:2.25rem; font-weight:700;
                                    border:4px solid var(--bps-primary-subtle); box-shadow:0 4px 16px rgba(0,0,0,0.12);">
                            @initials.ToUpper()
                        </div>
                    }
                </div>

                <h5 class="fw-bold mb-1" style="color:var(--bps-gray-800);">@Model.FullName</h5>
                <p class="text-muted mb-4" style="font-size:0.875rem;">Upload a new profile photo below</p>

                <form asp-action="UpdatePhoto" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3 text-start">
                        <label class="form-label fw-semibold" style="font-size:0.875rem;">Choose Image</label>
                        <input asp-for="PhotoFile" class="form-control form-control-sm"
                               type="file" accept=".jpg,.jpeg,.png" required
                               id="profile-photo-input" />
                        <div class="form-text">
                            <i class="bi bi-info-circle me-1"></i>
                            Accepted: .jpg, .jpeg, .png &nbsp;·&nbsp; Max size: 10MB
                        </div>
                    </div>

                    <!-- Preview thumbnail -->
                    <div id="photo-preview-wrap" class="d-none mb-3">
                        <img id="photo-preview" src="#" alt="Preview"
                             style="width:80px; height:80px; border-radius:50%; object-fit:cover; border:3px solid var(--bps-primary-subtle);" />
                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-upload me-2"></i>Update Photo
                    </button>
                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
    // Live photo preview
    document.getElementById('profile-photo-input').addEventListener('change', function () {
        const file = this.files[0];
        if (!file) return;
        const maxBytes = 10 * 1024 * 1024;
        if (file.size > maxBytes) {
            alert('File exceeds the 10MB limit. Please choose a smaller image.');
            this.value = '';
            return;
        }
        const reader = new FileReader();
        reader.onload = function (e) {
            const wrap    = document.getElementById('photo-preview-wrap');
            const preview = document.getElementById('photo-preview');
            preview.src   = e.target.result;
            wrap.classList.remove('d-none');
        };
        reader.readAsDataURL(file);
    });
    </script>
}
