@using BarangayPharmaSystem.Models.Entities
@model IEnumerable<BarangayPharmaSystem.Areas.Patient.Models.PatientRefillRequestListViewModel>
@{
    ViewData["Title"] = "My Refill Requests";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0 text-gray-800">My Refill Requests</h1>
</div>

<div class="card shadow-sm border-0 rounded mb-4" style="border-top: 4px solid #1A6FA3 !important;">
    <div class="card-header py-3 bg-white border-bottom d-flex flex-row align-items-center justify-content-between">
        <h6 class="m-0 font-weight-bold" style="color: #1A6FA3;">Refill History</h6>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="bps-empty-state p-5">
                <i class="bi bi-arrow-repeat bps-empty-state-icon bps-empty-state-icon-float text-primary" style="opacity: 0.4;"></i>
                <div class="bps-empty-state-title">No Refill Requests Yet</div>
                <p class="bps-empty-state-subtitle">You have not submitted any refill requests yet. Once you submit a request, you will see it tracked here.</p>
                <a asp-area="Patient" asp-controller="Prescriptions" asp-action="Index" class="btn btn-primary mt-2">
                    <i class="bi bi-plus-lg me-1"></i>Request Refill
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0" width="100%" cellspacing="0">
                    <thead class="bg-light">
                        <tr>
                            <th class="border-top-0">Requested On</th>
                            <th class="border-top-0">Medicine</th>
                            <th class="border-top-0">Notes</th>
                            <th class="border-top-0 text-center">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="align-middle text-muted">@item.RequestDate.ToLocalTime().ToString("MMM dd, yyyy")</td>
                                <td class="align-middle fw-semibold text-primary">
                                    @item.MedicineName <br/>
                                    <small class="text-muted">@item.Dosage</small>
                                </td>
                                <td class="align-middle text-muted">@(string.IsNullOrEmpty(item.Notes) ? "—" : item.Notes)</td>
                                <td class="align-middle text-center">
                                    @switch (item.Status)
                                    {
                                        case RefillRequestStatus.Pending:
                                            <span class="badge bps-badge-pending px-3 py-2">Pending Review</span>
                                            break;
                                        case RefillRequestStatus.Approved:
                                            <span class="badge bps-badge-completed px-3 py-2">Approved</span>
                                            break;
                                        case RefillRequestStatus.Rejected:
                                            <span class="badge bps-badge-expired px-3 py-2">Rejected</span>
                                            break;
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
