@using BarangayPharmaSystem.Models.Entities
@model IEnumerable<BarangayPharmaSystem.Areas.Patient.Models.PatientPrescriptionListViewModel>
@{
    ViewData["Title"] = "My Prescriptions";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0 text-gray-800">My Prescriptions</h1>
</div>

<div class="card shadow-sm border-0 rounded mb-4" style="border-top: 4px solid #1A6FA3 !important;">
    <div class="card-header py-3 bg-white border-bottom d-flex flex-row align-items-center justify-content-between">
        <h6 class="m-0 font-weight-bold" style="color: #1A6FA3;">Prescription Records</h6>
        <form method="get" asp-action="Index" class="form-inline">
            <select name="statusFilter" class="form-control bg-light border-0 small" onchange="this.form.submit()">
                <option value="">All Statuses</option>
                @foreach (var status in Enum.GetValues(typeof(PrescriptionStatus)))
                {
                    @if (ViewData["StatusFilter"]?.ToString() == status.ToString())
                    {
                        <option value="@status" selected>@status</option>
                    }
                    else
                    {
                        <option value="@status">@status</option>
                    }
                }
            </select>
        </form>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0" width="100%" cellspacing="0">
                <thead class="bg-light">
                    <tr>
                        <th class="border-top-0">Date Prescribed</th>
                        <th class="border-top-0">Medicine</th>
                        <th class="border-top-0">Dosage</th>
                        <th class="border-top-0">Doctor</th>
                        <th class="border-top-0 text-center">Status</th>
                        <th class="border-top-0 text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="align-middle text-muted">@item.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td class="align-middle font-weight-bold" style="color: #1A6FA3;">@item.MedicineName</td>
                            <td class="align-middle">@item.Dosage <br/> <small class="text-muted">Duration: @item.Duration</small></td>
                            <td class="align-middle">@item.DoctorName</td>
                            <td class="align-middle text-center">
                                @switch (item.Status)
                                {
                                    case PrescriptionStatus.Active:
                                        <span class="badge badge-primary px-2 py-1" style="background-color: #1A6FA3;">Active</span>
                                        break;
                                    case PrescriptionStatus.Completed:
                                        <span class="badge badge-success px-2 py-1">Completed</span>
                                        break;
                                    case PrescriptionStatus.Expired:
                                        <span class="badge badge-warning text-dark px-2 py-1">Expired</span>
                                        break;
                                    case PrescriptionStatus.Cancelled:
                                        <span class="badge badge-danger px-2 py-1">Cancelled</span>
                                        break;
                                    case PrescriptionStatus.Refilled:
                                        <span class="badge badge-info px-2 py-1">Refilled</span>
                                        break;
                                }
                            </td>
                            <td class="align-middle text-center">
                                @if (item.CanRequestRefill)
                                {
                                    <a asp-area="Patient" asp-controller="Refills" asp-action="Create" asp-route-prescriptionId="@item.Id" class="btn btn-sm btn-outline-primary shadow-sm" style="border-color: #1A6FA3; color: #1A6FA3;">
                                        <i class="fas fa-sync-alt mr-1"></i> Request Refill
                                    </a>
                                }
                                else if (item.Status == PrescriptionStatus.Active || item.Status == PrescriptionStatus.Refilled)
                                {
                                    <button class="btn btn-sm btn-light text-muted" data-bs-toggle="tooltip" data-bs-placement="top" title="@item.RefillBlockReason">
                                        <i class="fas fa-ban mr-1"></i> Blocked
                                    </button>
                                }
                                else
                                {
                                    <span class="text-muted small"><i class="fas fa-lock mr-1"></i> Locked</span>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="fas fa-file-medical-alt fa-3x mb-3 text-light"></i><br/>
                                You have no prescriptions recorded.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
