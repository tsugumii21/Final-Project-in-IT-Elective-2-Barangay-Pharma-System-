@using BarangayPharmaSystem.Models.Entities
@model IEnumerable<BarangayPharmaSystem.Areas.Patient.Models.PatientPrescriptionListViewModel>
@{
    ViewData["Title"] = "My Prescriptions";
    ViewData["PageTitle"] = "My Prescriptions";
    var currentStatus = ViewData["StatusFilter"]?.ToString() ?? "";
}

<!-- Page Header -->
<div class="bps-page-header">
    <div>
        <h1 class="bps-page-title">My Prescriptions</h1>
        <p class="bps-page-subtitle">All prescriptions assigned to you by your health center</p>
    </div>
</div>

<div class="bps-card mb-4">

    <!-- Pill filter buttons -->
    <div class="bps-filter-pills">
        @{
            var filters = new[] {
                ("",           "All"),
                ("Active",     "Active"),
                ("Completed",  "Completed"),
                ("Expired",    "Expired"),
                ("Refilled",   "Refilled"),
            };
        }
        @foreach (var (val, label) in filters)
        {
            <a href="?statusFilter=@val"
               class="bps-filter-pill @(currentStatus == val ? "active" : "")">
                @label
            </a>
        }
    </div>

    <!-- Table -->
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="border-top-0">Date Prescribed</th>
                    <th class="border-top-0">Medicine</th>
                    <th class="border-top-0">Dosage</th>
                    <th class="border-top-0">Doctor</th>
                    <th class="border-top-0 text-center">Status</th>
                    <th class="border-top-0 text-center">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="align-middle text-muted" style="font-size:0.85rem; white-space:nowrap;">
                            @item.CreatedAt.ToString("MMM dd, yyyy")
                        </td>
                        <td class="align-middle fw-semibold" style="color: var(--bps-primary);">
                            @item.MedicineName
                        </td>
                        <td class="align-middle" style="font-size:0.875rem;">
                            @item.Dosage<br />
                            <small class="text-muted">Duration: @item.Duration</small>
                        </td>
                        <td class="align-middle" style="font-size:0.875rem;">@item.DoctorName</td>
                        <td class="align-middle text-center">
                            @switch (item.Status)
                            {
                                case PrescriptionStatus.Active:
                                    <span class="badge bps-badge-active px-3 py-2">Active</span>
                                    break;
                                case PrescriptionStatus.Completed:
                                    <span class="badge bps-badge-completed px-3 py-2">Completed</span>
                                    break;
                                case PrescriptionStatus.Expired:
                                    <span class="badge bps-badge-expired px-3 py-2">Expired</span>
                                    break;
                                case PrescriptionStatus.Cancelled:
                                    <span class="badge bps-badge-cancelled px-3 py-2">Cancelled</span>
                                    break;
                                case PrescriptionStatus.Refilled:
                                    <span class="badge bps-badge-refilled px-3 py-2">Refilled</span>
                                    break;
                            }
                        </td>
                        <td class="align-middle text-center">
                            @if (item.CanRequestRefill)
                            {
                                <a asp-area="Patient" asp-controller="Refills" asp-action="Create"
                                   asp-route-prescriptionId="@item.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-arrow-repeat me-1"></i>Request Refill
                                </a>
                            }
                            else if (item.Status == PrescriptionStatus.Active || item.Status == PrescriptionStatus.Refilled)
                            {
                                <button class="btn btn-sm btn-light text-muted"
                                        data-bs-toggle="tooltip"
                                        data-bs-placement="top"
                                        title="@item.RefillBlockReason"
                                        disabled>
                                    <i class="bi bi-clock me-1"></i>Refill Soon
                                </button>
                            }
                            else
                            {
                                <span class="text-muted small">
                                    <i class="bi bi-lock-fill me-1"></i>Locked
                                </span>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="py-5">
                            <div class="bps-empty-state">
                                <i class="bi bi-file-earmark-medical bps-empty-state-icon bps-empty-state-icon-float"></i>
                                <div class="bps-empty-state-title">No Prescriptions Found</div>
                                <p class="bps-empty-state-subtitle">
                                    @if (!string.IsNullOrEmpty(currentStatus))
                                    {
                                        <text>No <strong>@currentStatus</strong> prescriptions on record.</text>
                                    }
                                    else
                                    {
                                        <text>You have no prescriptions recorded yet.</text>
                                    }
                                </p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
    // Initialize Bootstrap tooltips
    document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) {
        new bootstrap.Tooltip(el);
    });
    </script>
}
