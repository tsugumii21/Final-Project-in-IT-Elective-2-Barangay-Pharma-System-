@model BarangayPharmaSystem.Areas.Patient.Models.PatientDashboardViewModel
@using BarangayPharmaSystem.Models.Entities
@{
    ViewData["Title"] = "Dashboard";
    ViewData["PageTitle"] = "Patient Dashboard";

    var nameParts = (Model.PatientName ?? "P").Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initials  = nameParts.Length >= 2
        ? $"{nameParts[0][0]}{nameParts[^1][0]}"
        : nameParts[0][0].ToString();
}

<!-- ── Greeting / Welcome Card (full-width Medical Blue gradient) ───────── -->
<div class="bps-welcome-card mb-4">
    <div class="bps-welcome-card-bg"></div>
    <div class="bps-welcome-card-body">
        <!-- Avatar -->
        <div class="bps-welcome-avatar">
            @if (!string.IsNullOrWhiteSpace(Model.ProfilePhotoPath))
            {
                <img src="~/@Model.ProfilePhotoPath.TrimStart('/')" alt="@Model.PatientName" />
            }
            else
            {
                <span>@initials.ToUpper()</span>
            }
        </div>
        <!-- Text -->
        <div class="bps-welcome-text">
            <h1 class="bps-welcome-greeting">Welcome back, @Model.PatientName!</h1>
            <p class="bps-welcome-sub">Here is the latest update on your pharmacy records and health status.</p>
        </div>
        <!-- Quick actions -->
        <div class="bps-welcome-actions">
            <a asp-area="Patient" asp-controller="Prescriptions" asp-action="Index"
               class="btn btn-light btn-sm px-3">
                <i class="bi bi-file-earmark-medical me-1"></i>Prescriptions
            </a>
            <a asp-area="Patient" asp-controller="Refills" asp-action="Index"
               class="btn btn-outline-light btn-sm px-3">
                <i class="bi bi-arrow-repeat me-1"></i>Refills
            </a>
        </div>
    </div>
</div>

<!-- ── Summary Cards (3-column, 36px bold numbers) ──────────────────────── -->
<div class="row g-4 mb-4">
    <div class="col-xl-4 col-md-6 bps-card-animate" style="--delay: 0">
        <a asp-area="Patient" asp-controller="Prescriptions" asp-action="Index"
           class="bps-stat-card bps-stat-card-clickable">
            <div class="bps-stat-icon bps-stat-icon-primary">
                <i class="bi bi-file-earmark-medical-fill"></i>
            </div>
            <div class="bps-stat-content">
                <div class="bps-stat-value bps-stat-value-lg">@Model.ActivePrescriptions</div>
                <div class="bps-stat-label">Active Prescriptions</div>
            </div>
        </a>
    </div>
    <div class="col-xl-4 col-md-6 bps-card-animate" style="--delay: 1">
        <a asp-area="Patient" asp-controller="History" asp-action="Index"
           class="bps-stat-card bps-stat-card-clickable">
            <div class="bps-stat-icon bps-stat-icon-success">
                <i class="bi bi-capsule-pill"></i>
            </div>
            <div class="bps-stat-content">
                <div class="bps-stat-value bps-stat-value-lg">@Model.TotalDispensingRecords</div>
                <div class="bps-stat-label">Total Dispensings</div>
            </div>
        </a>
    </div>
    <div class="col-xl-4 col-md-6 bps-card-animate" style="--delay: 2">
        <a asp-area="Patient" asp-controller="Refills" asp-action="Index"
           class="bps-stat-card bps-stat-card-clickable">
            <div class="bps-stat-icon bps-stat-icon-warning">
                <i class="bi bi-arrow-repeat"></i>
            </div>
            <div class="bps-stat-content">
                <div class="bps-stat-value bps-stat-value-lg">@Model.PendingRefillRequests</div>
                <div class="bps-stat-label">Pending Refills</div>
            </div>
        </a>
    </div>
</div>

<!-- ── Latest Prescription Activity ─────────────────────────────────────── -->
<div class="bps-card">
    <div class="bps-card-header">
        <h3 class="bps-card-title">
            <i class="bi bi-activity text-primary me-2"></i>Latest Prescription Activity
        </h3>
        <a asp-area="Patient" asp-controller="Prescriptions" asp-action="Index"
           class="btn btn-sm btn-outline-primary">View All</a>
    </div>
    <div class="bps-card-body p-4">
        @if (Model.LatestPrescription != null)
        {
            <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center
                        justify-content-between gap-3 p-4 rounded-3"
                 style="background: var(--bps-primary-subtle);">
                <div>
                    <h4 class="fw-bold mb-1" style="color: var(--bps-primary); font-family: var(--bps-font-heading);">
                        @Model.LatestPrescription.Medicine?.Name
                    </h4>
                    <p class="mb-1 fw-semibold" style="color: var(--bps-gray-700);">
                        @Model.LatestPrescription.Dosage — @Model.LatestPrescription.Duration
                    </p>
                    <small class="text-muted">
                        Prescribed on @Model.LatestPrescription.CreatedAt.ToString("MMMM dd, yyyy")
                    </small>
                </div>
                <div class="text-start text-md-end">
                    @switch (Model.LatestPrescription.Status)
                    {
                        case PrescriptionStatus.Active:
                            <span class="badge bps-badge-active px-3 py-2 mb-2 d-inline-block">Active</span>
                            break;
                        case PrescriptionStatus.Completed:
                            <span class="badge bps-badge-completed px-3 py-2 mb-2 d-inline-block">Completed</span>
                            break;
                        case PrescriptionStatus.Expired:
                            <span class="badge bps-badge-expired px-3 py-2 mb-2 d-inline-block">Expired</span>
                            break;
                        case PrescriptionStatus.Cancelled:
                            <span class="badge bps-badge-cancelled px-3 py-2 mb-2 d-inline-block">Cancelled</span>
                            break;
                        case PrescriptionStatus.Refilled:
                            <span class="badge bps-badge-refilled px-3 py-2 mb-2 d-inline-block">Refilled</span>
                            break;
                    }
                    <br />
                    <a asp-area="Patient" asp-controller="Prescriptions" asp-action="Index"
                       class="btn btn-primary btn-sm">
                        <i class="bi bi-arrow-right me-1"></i>View All Prescriptions
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="bps-empty-state">
                <i class="bi bi-file-earmark-medical bps-empty-state-icon bps-empty-state-icon-float"></i>
                <div class="bps-empty-state-title">No Prescriptions Yet</div>
                <p class="bps-empty-state-subtitle">You have no prescriptions recorded yet. Visit your health center to get started.</p>
            </div>
        }
    </div>
</div>
