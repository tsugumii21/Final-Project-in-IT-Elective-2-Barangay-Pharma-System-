@model BarangayPharmaSystem.Areas.Patient.Models.PatientDashboardViewModel
@{
    ViewData["Title"] = "Patient Dashboard";
}

<div class="bps-page-header">
    <div>
        <h1 class="bps-page-title">Patient Dashboard</h1>
        <p class="bps-page-subtitle">Overview of your prescriptions and refills</p>
    </div>
</div>

<div class="bps-card mb-4" style="border-left: 4px solid var(--bps-primary);">
    <div class="bps-card-body p-4 d-flex flex-column flex-md-row align-items-center gap-4">
        @if (!string.IsNullOrEmpty(Model.ProfilePhotoPath))
        {
            <img src="~/@Model.ProfilePhotoPath" alt="Profile" class="bps-profile-photo shadow-sm" style="width: 80px; height: 80px;" />
        }
        else
        {
            <div class="bps-profile-photo-placeholder shadow-sm mx-auto mx-md-0" style="width: 80px; height: 80px; font-size: 2rem;">
                <i class="bi bi-person-fill"></i>
            </div>
        }
        <div class="text-center text-md-start">
            <h2 class="fw-bold text-gray-900 mb-1" style="font-family: var(--bps-font-heading);">Welcome back, @Model.PatientName!</h2>
            <p class="mb-0 text-secondary">Here is the latest update on your pharmacy records and health status.</p>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Active Prescriptions -->
    <div class="col-xl-4 col-md-6">
        <a asp-area="Patient" asp-controller="Prescriptions" asp-action="Index" class="bps-stat-card">
            <div class="bps-stat-icon bps-stat-icon-primary">
                <i class="bi bi-file-earmark-medical"></i>
            </div>
            <div class="bps-stat-content">
                <div class="bps-stat-value">@Model.ActivePrescriptions</div>
                <div class="bps-stat-label">Active Prescriptions</div>
            </div>
        </a>
    </div>

    <!-- Dispensing Records -->
    <div class="col-xl-4 col-md-6">
        <a asp-area="Patient" asp-controller="History" asp-action="Index" class="bps-stat-card">
            <div class="bps-stat-icon bps-stat-icon-success">
                <i class="bi bi-capsule"></i>
            </div>
            <div class="bps-stat-content">
                <div class="bps-stat-value">@Model.TotalDispensingRecords</div>
                <div class="bps-stat-label">Total Dispensings</div>
            </div>
        </a>
    </div>

    <!-- Pending Refills -->
    <div class="col-xl-4 col-md-6">
        <a asp-area="Patient" asp-controller="Refills" asp-action="Index" class="bps-stat-card">
            <div class="bps-stat-icon bps-stat-icon-warning">
                <i class="bi bi-arrow-repeat"></i>
            </div>
            <div class="bps-stat-content">
                <div class="bps-stat-value">@Model.PendingRefillRequests</div>
                <div class="bps-stat-label">Pending Refills</div>
            </div>
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Latest Prescription Widget -->
    <div class="col-12">
        <div class="bps-card">
            <div class="bps-card-header bg-white border-bottom py-3">
                <h3 class="bps-card-title text-primary"><i class="bi bi-activity me-2"></i> Latest Prescription Activity</h3>
            </div>
            <div class="bps-card-body">
                @if (Model.LatestPrescription != null)
                {
                    <div class="d-flex flex-column flex-md-row align-items-center justify-content-between p-4 rounded-3 animate-fade-in" style="background-color: var(--bps-primary-subtle);">
                        <div class="mb-3 mb-md-0 text-center text-md-start">
                            <h4 class="fw-bold text-primary mb-1" style="font-family: var(--bps-font-heading);">@Model.LatestPrescription.Medicine.Name</h4>
                            <p class="text-gray-800 mb-1 fw-semibold">@Model.LatestPrescription.Dosage — @Model.LatestPrescription.Duration</p>
                            <small class="text-muted d-block">Prescribed on @Model.LatestPrescription.CreatedAt.ToString("MMMM dd, yyyy")</small>
                        </div>
                        <div class="text-center text-md-end">
                            <div class="mb-3">
                                @switch (Model.LatestPrescription.Status)
                                {
                                    case BarangayPharmaSystem.Models.Entities.PrescriptionStatus.Active:
                                        <span class="badge bg-primary rounded-pill px-3 py-1.5 fw-semibold">Active</span>
                                        break;
                                    case BarangayPharmaSystem.Models.Entities.PrescriptionStatus.Completed:
                                        <span class="badge bg-success rounded-pill px-3 py-1.5 fw-semibold">Completed</span>
                                        break;
                                    case BarangayPharmaSystem.Models.Entities.PrescriptionStatus.Expired:
                                        <span class="badge bg-warning text-dark rounded-pill px-3 py-1.5 fw-semibold">Expired</span>
                                        break;
                                    case BarangayPharmaSystem.Models.Entities.PrescriptionStatus.Cancelled:
                                        <span class="badge bg-danger rounded-pill px-3 py-1.5 fw-semibold">Cancelled</span>
                                        break;
                                    case BarangayPharmaSystem.Models.Entities.PrescriptionStatus.Refilled:
                                        <span class="badge bg-info text-dark rounded-pill px-3 py-1.5 fw-semibold">Refilled</span>
                                        break;
                                }
                            </div>
                            <a asp-area="Patient" asp-controller="Prescriptions" asp-action="Index" class="btn btn-primary btn-sm">
                                View All Prescriptions
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <div class="bps-empty-state-icon-float text-muted fs-1 mb-3">
                            <i class="bi bi-file-earmark-medical text-primary" style="opacity: 0.4;"></i>
                        </div>
                        <p class="text-muted mb-0">You have no recorded prescriptions yet.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
