@{
    ViewData["Title"] = "Profile Not Found";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded" style="border-top: 4px solid #1A6FA3 !important;">
                <div class="card-body text-center p-5">
                    <i class="fas fa-user-times fa-4x text-muted mb-4"></i>
                    <h2 class="h4 font-weight-bold text-gray-800 mb-3">No Linked Profile Found</h2>
                    <p class="text-muted mb-4">
                        Your account is currently not linked to any Patient ID in our system. <br/>
                        Please contact the Pharmacy Staff to verify your Patient Code.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
