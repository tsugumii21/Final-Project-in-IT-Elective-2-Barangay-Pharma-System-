@using BarangayPharmaSystem.Models.Entities
@model IEnumerable<BarangayPharmaSystem.Areas.Staff.Models.StaffRefillRequestListViewModel>
@{
    ViewData["Title"] = "Refill Requests";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0 text-gray-800">Refill Requests</h1>
</div>

<div class="card shadow mb-4 glass-card border-left-warning">
    <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
        <h6 class="m-0 font-weight-bold text-warning">Patient Refill Requests</h6>
        <form method="get" asp-action="Index" class="form-inline">
            <div class="input-group">
                <select name="statusFilter" class="form-select bg-light small" style="min-width: 150px;" onchange="this.form.submit()">
                    <option value="">All Statuses</option>
                    @foreach (var status in Enum.GetValues(typeof(RefillRequestStatus)))
                    {
                        @if (ViewData["StatusFilter"]?.ToString() == status.ToString())
                        {
                            <option value="@status" selected>@status</option>
                        }
                        else
                        {
                            <option value="@status">@status</option>
                        }
                    }
                </select>
            </div>
        </form>
    </div>
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="bps-empty-state p-5">
                <i class="bi bi-arrow-repeat bps-empty-state-icon bps-empty-state-icon-float text-primary" style="opacity: 0.4;"></i>
                <div class="bps-empty-state-title">No Refill Requests</div>
                <p class="bps-empty-state-subtitle">
                    @if (ViewData["StatusFilter"] != null && !string.IsNullOrEmpty(ViewData["StatusFilter"]?.ToString()))
                    {
                        <text>No refill requests match the filtered status "@ViewData["StatusFilter"]".</text>
                    }
                    else
                    {
                        <text>There are no active patient refill requests recorded in the system yet.</text>
                    }
                </p>
                @if (ViewData["StatusFilter"] != null && !string.IsNullOrEmpty(ViewData["StatusFilter"]?.ToString()))
                {
                    <a asp-action="Index" class="btn btn-outline-primary btn-sm">Clear Filters</a>
                }
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Requested On</th>
                            <th>Patient</th>
                            <th>Medicine</th>
                            <th class="text-center">Status</th>
                            <th class="text-center">Stock Level</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="align-middle text-muted" style="font-size:0.85rem;">@item.RequestDate.ToLocalTime().ToString("MMM dd, yyyy")</td>
                                <td class="align-middle fw-semibold">@item.PatientName</td>
                                <td class="align-middle">
                                    <strong style="color:var(--bps-primary);">@item.MedicineName</strong><br/>
                                    <small class="text-muted">@item.PrescriptionDosage</small>
                                </td>
                                <td class="align-middle text-center">
                                    @switch (item.Status)
                                    {
                                        case RefillRequestStatus.Pending:
                                            <span class="badge bps-badge-pending px-3 py-2">Pending</span>
                                            break;
                                        case RefillRequestStatus.Approved:
                                            <span class="badge bps-badge-completed px-3 py-2">Approved</span>
                                            break;
                                        case RefillRequestStatus.Rejected:
                                            <span class="badge bps-badge-expired px-3 py-2">Rejected</span>
                                            break;
                                    }
                                </td>
                                <td class="align-middle text-center">
                                    @if (item.CurrentStock <= 0)
                                    {
                                        <span class="badge bps-badge-expired px-2.5 py-1.5">Out of Stock</span>
                                    }
                                    else if (item.CurrentStock < 20)
                                    {
                                        <span class="badge bps-badge-pending px-2.5 py-1.5">Low: @item.CurrentStock</span>
                                    }
                                    else
                                    {
                                        <span class="badge bps-badge-completed px-2.5 py-1.5">@item.CurrentStock units</span>
                                    }
                                </td>
                                <td class="align-middle text-center">
                                    @if (item.Status == RefillRequestStatus.Pending)
                                    {
                                        <div class="d-flex gap-2 justify-content-center">
                                            <button type="button" class="btn btn-primary btn-sm px-3" data-bs-toggle="modal" data-bs-target="#approveModal-@item.Id" @(item.CurrentStock <= 0 ? "disabled" : "") title="Approve">
                                                <i class="bi bi-check-lg me-1"></i>Approve
                                            </button>
                                            <button type="button" class="btn btn-danger btn-sm px-3" data-bs-toggle="modal" data-bs-target="#rejectModal-@item.Id" title="Reject">
                                                <i class="bi bi-x-lg me-1"></i>Reject
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-outline-primary btn-sm px-3" data-bs-toggle="modal" data-bs-target="#detailsModal-@item.Id" title="View Details">
                                            <i class="bi bi-search me-1"></i>Details
                                        </button>
                                    }
                                </td>
                            </tr>

                            <!-- Details Modal -->
                            <div class="modal fade" id="detailsModal-@item.Id" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content border-0 shadow-lg">
                                        <div class="modal-header text-white border-0" style="background:var(--bps-primary);">
                                            <h5 class="modal-title fw-bold"><i class="bi bi-info-circle-fill me-2"></i> Request Details</h5>
                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body p-4">
                                            <div class="mb-3"><strong>Patient:</strong> <span class="text-secondary">@item.PatientName</span></div>
                                            <div class="mb-3"><strong>Medicine:</strong> <span class="text-secondary">@item.MedicineName</span></div>
                                            <div class="mb-0"><strong>Notes / Reason:</strong> <br/> <span class="text-secondary">@item.PatientNotes</span></div>
                                        </div>
                                        <div class="modal-footer border-0">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Approve Modal -->
                            <div class="modal fade" id="approveModal-@item.Id" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content border-0 shadow-lg">
                                        <div class="modal-header text-white border-0 bg-success">
                                            <h5 class="modal-title fw-bold"><i class="bi bi-check-circle-fill me-2"></i> Approve Refill</h5>
                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <form asp-action="Approve" method="post">
                                            @Html.AntiForgeryToken()
                                            <div class="modal-body p-4">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <p class="mb-2">Approve refill for <strong>@item.PatientName</strong>.</p>
                                                <p class="text-muted small">Medicine: <strong>@item.MedicineName</strong> (Current Stock: @item.CurrentStock)</p>
                                                
                                                <div class="form-group mt-3">
                                                    <label class="form-label text-secondary">Quantity to Dispense:</label>
                                                    <input type="number" name="quantityToDispense" class="form-control" required min="1" max="@item.CurrentStock" value="1" />
                                                    <small class="form-text text-muted">This will automatically deduct stock and create a dispensing record.</small>
                                                </div>
                                            </div>
                                            <div class="modal-footer border-0">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                <button type="submit" class="btn btn-primary px-4">Approve & Dispense</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>

                            <!-- Reject Modal -->
                            <div class="modal fade" id="rejectModal-@item.Id" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content border-0 shadow-lg">
                                        <div class="modal-header text-white border-0 bg-danger">
                                            <h5 class="modal-title fw-bold"><i class="bi bi-x-circle-fill me-2"></i> Reject Refill</h5>
                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <form asp-action="Reject" method="post">
                                            @Html.AntiForgeryToken()
                                            <div class="modal-body p-4">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <p class="mb-2">Reject refill for <strong>@item.PatientName</strong>.</p>
                                                
                                                <div class="form-group mt-3">
                                                    <label class="form-label text-secondary">Reason for Rejection:</label>
                                                    <textarea name="rejectionNotes" class="form-control" required rows="3" placeholder="e.g. Too early for refill, out of stock, requires doctor's checkup..."></textarea>
                                                </div>
                                            </div>
                                            <div class="modal-footer border-0">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                <button type="submit" class="btn btn-danger px-4">Reject Request</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
