@model BarangayPharmaSystem.Areas.Staff.Models.StaffDispensingFormViewModel
@{
    ViewData["Title"] = "Dispense Medicine";
    ViewData["PageTitle"] = "Dispense Medicine";
}

<!-- Page Header -->
<div class="bps-page-header">
    <div>
        <h1 class="bps-page-title">Dispense Medicine</h1>
        <p class="bps-page-subtitle">Fill in the prescription details to record a dispensing transaction</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-2"></i>Back to Log
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="bps-card">
            <div class="bps-card-header">
                <h3 class="bps-card-title"><i class="bi bi-capsule text-primary me-2"></i>Dispensing Details</h3>
            </div>
            <div class="bps-card-body p-4">

                <!-- Inline error area (shown after failed submit instead of page freeze) -->
                <div id="dispense-error-alert" class="bps-alert bps-alert-error d-none mb-3" role="alert">
                    <i class="bi bi-exclamation-circle-fill me-2"></i>
                    <span id="dispense-error-text">An error occurred. Please try again.</span>
                </div>

                <form asp-action="Create" method="post" id="dispenseForm">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="PrescriptionId" class="form-label fw-semibold">Active Prescription</label>
                        <select asp-for="PrescriptionId" asp-items="ViewBag.Prescriptions"
                                class="form-select" required id="prescription-select">
                            <option value="">— Select Active Prescription —</option>
                        </select>
                        <span asp-validation-for="PrescriptionId" class="text-danger small"></span>
                        <div class="form-text">Only patients with Active or Refilled prescriptions appear here.</div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Quantity" class="form-label fw-semibold">Quantity to Dispense</label>
                        <div class="input-group">
                            <input asp-for="Quantity" class="form-control"
                                   type="number" min="1" value="1" id="qty-input" />
                            <span class="input-group-text" style="background:var(--bps-primary); color:#fff; border-color:var(--bps-primary);">units</span>
                        </div>
                        <span asp-validation-for="Quantity" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Notes" class="form-label fw-semibold">Notes <span class="text-muted fw-normal">(optional)</span></label>
                        <textarea asp-for="Notes" class="form-control" rows="2"
                                  placeholder="Any additional dispensing notes..."></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>

                    <hr class="my-4" />

                    <button type="submit" class="btn btn-primary w-100" id="openConfirmBtn">
                        <i class="bi bi-check-circle-fill me-2"></i>Dispense Now
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- ── Confirmation Modal ──────────────────────────────────────────────── -->
<div class="modal fade" id="confirmDispenseModal" tabindex="-1"
     aria-labelledby="confirmDispenseLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">

            <!-- Medical Blue header — NOT warning yellow -->
            <div class="modal-header border-0" style="background: var(--bps-primary);">
                <h5 class="modal-title fw-bold text-white" id="confirmDispenseLabel">
                    <i class="bi bi-capsule me-2"></i>Confirm Dispensing
                </h5>
                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body py-4 px-4">
                <p class="mb-2 text-center" style="font-size: 1rem; color: var(--bps-gray-700); line-height: 1.7;">
                    You are about to deduct stock and record this dispensing transaction.
                </p>
                <p class="text-center mb-0">
                    <strong style="color: var(--bps-danger);">This action cannot be undone by Staff.</strong><br/>
                    Are you sure the details are correct?
                </p>
            </div>

            <div class="modal-footer border-0 d-flex justify-content-center gap-3 pb-4">
                <button type="button" class="btn btn-outline-secondary px-4"
                        data-bs-dismiss="modal" id="cancelDispenseBtn">
                    <i class="bi bi-x-lg me-2"></i>Cancel
                </button>
                <button type="button" class="btn btn-primary px-4" id="confirmDispenseBtn">
                    <i class="bi bi-check-circle-fill me-2"></i>Yes, Dispense
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
    (function () {
        'use strict';

        const confirmBtn = document.getElementById('confirmDispenseBtn');
        const cancelBtn  = document.getElementById('cancelDispenseBtn');
        const form       = document.getElementById('dispenseForm');
        const modal      = document.getElementById('confirmDispenseModal');

        // Move the modal to the body to prevent stacking context z-index overlap issues
        if (modal) {
            document.body.appendChild(modal);
        }

        // Handle form submit (e.g. from submit button or Enter key)
        form.addEventListener('submit', function (e) {
            // If already confirming and submitting, allow it
            if (confirmBtn.disabled) {
                return;
            }

            // Otherwise, prevent default browser submit
            e.preventDefault();

            // Validate the form
            let isValid = true;
            if (typeof $ !== 'undefined' && $(form).length > 0) {
                isValid = $(form).valid();
            } else {
                isValid = form.checkValidity();
                if (!isValid) {
                    form.reportValidity();
                }
            }

            // Show confirmation modal if valid
            if (isValid) {
                const bsModal = bootstrap.Modal.getOrCreateInstance(modal);
                if (bsModal) {
                    bsModal.show();
                }
            }
        });

        // "Yes, Dispense" click - clean up and submit natively
        confirmBtn.addEventListener('click', function () {
            // Disable buttons immediately to prevent double submission
            confirmBtn.disabled = true;
            confirmBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span>Dispensing...';
            cancelBtn.disabled = true;

            // Immediately clean up modal classes and backdrop to prevent page freeze
            document.querySelectorAll('.modal-backdrop').forEach(el => el.remove());
            document.body.classList.remove('modal-open');
            document.body.style.overflow = '';
            document.body.style.paddingRight = '';

            const bsModal = bootstrap.Modal.getInstance(modal);
            if (bsModal) {
                bsModal.hide();
            }

            // Natively submit form (bypasses form 'submit' event listener)
            form.submit();
        });
    })();
    </script>
}
