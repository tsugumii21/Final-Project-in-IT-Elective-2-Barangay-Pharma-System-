@model BarangayPharmaSystem.Areas.Staff.Models.StaffDispensingFormViewModel
@{
    ViewData["Title"] = "Dispense Medicine";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0 text-gray-800">Dispense Medicine</h1>
    <a asp-action="Index" class="btn btn-secondary shadow-sm">
        <i class="fas fa-arrow-left fa-sm text-white-50 mr-1"></i> Back to Log
    </a>
</div>

<div class="row">
    <div class="col-lg-8 mx-auto">
        <div class="card shadow mb-4 glass-card border-left-success">
            <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                <h6 class="m-0 font-weight-bold text-success">Dispensing Details</h6>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post" id="dispenseForm">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="form-group mb-4">
                        <label asp-for="PrescriptionId" class="font-weight-bold text-gray-700"></label>
                        <select asp-for="PrescriptionId" asp-items="ViewBag.Prescriptions" class="form-control form-control-lg bg-light" required>
                            <option value="">-- Select Active Prescription --</option>
                        </select>
                        <span asp-validation-for="PrescriptionId" class="text-danger"></span>
                        <small class="form-text text-muted mt-2">Only patients with Active or Refilled prescriptions will appear here.</small>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="Quantity" class="font-weight-bold text-gray-700"></label>
                        <div class="input-group">
                            <input asp-for="Quantity" class="form-control form-control-lg bg-light font-weight-bold text-success" type="number" min="1" value="1" />
                            <div class="input-group-append">
                                <span class="input-group-text bg-success text-white border-0">units</span>
                            </div>
                        </div>
                        <span asp-validation-for="Quantity" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="Notes" class="font-weight-bold text-gray-700"></label>
                        <textarea asp-for="Notes" class="form-control bg-light" rows="2" placeholder="Any additional notes..."></textarea>
                        <span asp-validation-for="Notes" class="text-danger"></span>
                    </div>

                    <hr class="mt-4 mb-4">
                    <button type="button" class="btn btn-success btn-block btn-lg shadow-sm" data-toggle="modal" data-target="#confirmModal">
                        <i class="fas fa-check-circle mr-2"></i> Dispense Now
                    </button>

                    <!-- Confirmation Modal -->
                    <div class="modal fade" id="confirmModal" tabindex="-1" role="dialog" aria-labelledby="confirmModalLabel" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered" role="document">
                            <div class="modal-content border-0 shadow-lg">
                                <div class="modal-header bg-warning text-dark border-0">
                                    <h5 class="modal-title font-weight-bold" id="confirmModalLabel"><i class="fas fa-exclamation-triangle mr-2"></i> Confirm Dispensing</h5>
                                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                        <span aria-hidden="true">&times;</span>
                                    </button>
                                </div>
                                <div class="modal-body py-4">
                                    <p class="mb-0 text-center" style="font-size: 1.1rem;">
                                        You are about to deduct stock and record this transaction. <br/><br/>
                                        <strong>This action cannot be undone by Staff.</strong> <br/><br/>
                                        Are you sure the details are correct?
                                    </p>
                                </div>
                                <div class="modal-footer border-0 d-flex justify-content-center">
                                    <button type="button" class="btn btn-secondary px-4" data-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-success px-4" onclick="document.getElementById('dispenseForm').submit(); this.disabled=true; this.innerHTML='<i class=\'fas fa-spinner fa-spin\'></i> Dispensing...';">
                                        Yes, Dispense
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
