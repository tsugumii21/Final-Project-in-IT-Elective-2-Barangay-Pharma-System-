@model IEnumerable<BarangayPharmaSystem.Areas.Staff.Models.StaffDispensingListViewModel>
@{
    ViewData["Title"] = "Dispensing History";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0 text-gray-800">Dispensing Log</h1>
    <a asp-action="Create" class="btn btn-success shadow-sm glass-button">
        <i class="fas fa-pills fa-sm text-white-50 mr-1"></i> Dispense Medicine
    </a>
</div>

<div class="alert alert-warning border-left-warning shadow-sm mb-4">
    <div class="d-flex align-items-center">
        <i class="fas fa-exclamation-triangle fa-2x mr-3 text-warning"></i>
        <div>
            <strong>Notice:</strong> Dispensing records are <strong>irreversible</strong> by staff members. 
            Ensure quantity and patient details are correct before dispensing. If a mistake is made, please contact an Administrator.
        </div>
    </div>
</div>

<div class="card shadow mb-4 glass-card border-left-success">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-success">All Dispensing Records</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th>Date & Time</th>
                        <th>Patient</th>
                        <th>Medicine</th>
                        <th>Quantity Dispensed</th>
                        <th>Dispensed By</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="align-middle">@item.DateDispensed.ToLocalTime().ToString("MMM dd, yyyy hh:mm tt")</td>
                            <td class="align-middle font-weight-bold">@item.PatientName</td>
                            <td class="align-middle text-primary">@item.MedicineName</td>
                            <td class="align-middle text-center">
                                <span class="badge bps-badge-completed px-3 py-2" style="font-size: 1rem;">@item.QuantityDispensed</span>
                            </td>
                            <td class="align-middle text-muted">@item.StaffName</td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">
                                <i class="fas fa-info-circle mb-2"></i><br/>
                                No dispensing records found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
