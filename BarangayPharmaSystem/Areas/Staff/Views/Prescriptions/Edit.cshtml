@using BarangayPharmaSystem.Models.Entities
@model BarangayPharmaSystem.Areas.Staff.Models.StaffPrescriptionFormViewModel
@{
    ViewData["Title"] = "Edit Prescription";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0 text-gray-800">Edit Prescription</h1>
    <a asp-action="Index" class="btn btn-secondary shadow-sm">
        <i class="fas fa-arrow-left fa-sm text-white-50 mr-1"></i> Back to Directory
    </a>
</div>

<div class="row">
    <div class="col-lg-8 mx-auto">
        <div class="card shadow mb-4 glass-card border-left-info">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-info">Update Prescription Details</h6>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="form-group mb-4">
                        <label asp-for="PatientId" class="font-weight-bold text-gray-700"></label>
                        <select asp-for="PatientId" asp-items="ViewBag.Patients" class="form-control bg-light" required>
                            <option value="">-- Select Patient --</option>
                        </select>
                        <span asp-validation-for="PatientId" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="MedicineId" class="font-weight-bold text-gray-700"></label>
                        <select asp-for="MedicineId" asp-items="ViewBag.Medicines" class="form-control bg-light" required>
                            <option value="">-- Select Medicine --</option>
                        </select>
                        <span asp-validation-for="MedicineId" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="DoctorName" class="font-weight-bold text-gray-700"></label>
                        <input asp-for="DoctorName" class="form-control bg-light" />
                        <span asp-validation-for="DoctorName" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-4">
                                <label asp-for="Dosage" class="font-weight-bold text-gray-700"></label>
                                <input asp-for="Dosage" class="form-control bg-light" />
                                <span asp-validation-for="Dosage" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-4">
                                <label asp-for="Duration" class="font-weight-bold text-gray-700"></label>
                                <input asp-for="Duration" class="form-control bg-light" />
                                <span asp-validation-for="Duration" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group mb-4 border p-3 rounded bg-light">
                        <label asp-for="Status" class="font-weight-bold text-gray-700 mb-2 d-block">Prescription Status</label>
                        <select asp-for="Status" asp-items="Html.GetEnumSelectList<PrescriptionStatus>()" class="form-control font-weight-bold text-primary"></select>
                        <small class="form-text text-muted mt-2">
                            Only change status if necessary (e.g., cancelling an unfulfilled prescription).
                        </small>
                    </div>

                    <hr class="mt-4 mb-4">
                    <button type="submit" class="btn btn-info btn-block btn-lg shadow-sm">
                        <i class="fas fa-save mr-2"></i> Save Changes
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
