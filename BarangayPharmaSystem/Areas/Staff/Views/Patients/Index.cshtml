@model IEnumerable<BarangayPharmaSystem.Areas.Staff.Models.StaffPatientListViewModel>
@{
    ViewData["Title"] = "Patient Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0 text-gray-800">Patient Management</h1>
    <a asp-action="Create" class="btn btn-primary shadow-sm glass-button">
        <i class="fas fa-plus fa-sm text-white-50 mr-1"></i> Add New Patient
    </a>
</div>

<div class="card shadow mb-4 glass-card">
    <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
        <h6 class="m-0 font-weight-bold text-primary">Patient Directory</h6>
        <form method="get" asp-action="Index" class="form-inline">
            <div class="input-group">
                <input type="text" name="search" value="@ViewData["SearchQuery"]" class="form-control bg-light border-0 small" placeholder="Search by name, ID..." aria-label="Search">
                <div class="input-group-append">
                    <button class="btn btn-primary" type="submit">
                        <i class="fas fa-search fa-sm"></i>
                    </button>
                    @if (!string.IsNullOrEmpty(ViewData["SearchQuery"]?.ToString()))
                    {
                        <a asp-action="Index" class="btn btn-secondary">Clear</a>
                    }
                </div>
            </div>
        </form>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th>Photo</th>
                        <th>Patient ID</th>
                        <th>Full Name</th>
                        <th>Contact</th>
                        <th>Age</th>
                        <th>Account</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center align-middle">
                                @if (!string.IsNullOrEmpty(item.ProfilePhotoPath))
                                {
                                    <img src="~/@item.ProfilePhotoPath" class="rounded-circle" style="width: 40px; height: 40px; object-fit: cover;" alt="Profile" />
                                }
                                else
                                {
                                    <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center text-white mx-auto" style="width: 40px; height: 40px;">
                                        <i class="fas fa-user"></i>
                                    </div>
                                }
                            </td>
                            <td class="align-middle font-weight-bold text-primary">@item.PatientCode</td>
                            <td class="align-middle">@item.FullName</td>
                            <td class="align-middle">@item.ContactNumber</td>
                            <td class="align-middle">@item.Age</td>
                            <td class="align-middle text-center">
                                @if (item.HasLinkedAccount)
                                {
                                    <span class="badge badge-success"><i class="fas fa-check-circle"></i> Linked</span>
                                }
                                else
                                {
                                    <span class="badge badge-warning text-dark"><i class="fas fa-clock"></i> Pending</span>
                                }
                            </td>
                            <td class="align-middle text-center">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-circle btn-sm" title="View Details">
                                    <i class="fas fa-folder-open"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-circle btn-sm" title="Edit Patient">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this patient profile?');">
                                    <button type="submit" class="btn btn-danger btn-circle btn-sm" title="Delete Patient">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                <i class="fas fa-info-circle mb-2"></i><br/>
                                No patients found matching your criteria.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (TempData["PatientCodeAlert"] != null)
{
    <!-- Modal to show newly generated Patient Code -->
    <div class="modal fade show" id="patientCodeModal" tabindex="-1" role="dialog" style="display: block; background: rgba(0,0,0,0.5);" aria-labelledby="modalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content glass-card border-0">
                <div class="modal-header bg-primary text-white border-0">
                    <h5 class="modal-title" id="modalLabel"><i class="fas fa-id-card mr-2"></i>Patient Profile Created</h5>
                    <button type="button" class="close text-white" onclick="document.getElementById('patientCodeModal').style.display='none'" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body text-center py-4">
                    <p class="mb-2">Please provide this Patient ID to the patient.</p>
                    <p class="small text-muted mb-4">They will need it to register their online account.</p>
                    <h2 class="font-weight-bold text-primary mb-4 p-3 bg-light rounded border border-primary" style="letter-spacing: 2px;">
                        <span id="pCode">@TempData["PatientCodeAlert"]</span>
                    </h2>
                    <div class="d-flex justify-content-center">
                        <button class="btn btn-outline-primary mr-2" onclick="navigator.clipboard.writeText(document.getElementById('pCode').innerText); alert('Copied to clipboard!');">
                            <i class="fas fa-copy mr-1"></i> Copy Code
                        </button>
                        <button class="btn btn-primary" onclick="window.print()">
                            <i class="fas fa-print mr-1"></i> Print ID Stub
                        </button>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary" onclick="document.getElementById('patientCodeModal').style.display='none'">Close</button>
                </div>
            </div>
        </div>
    </div>
}
