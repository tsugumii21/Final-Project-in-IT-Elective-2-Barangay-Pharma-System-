@model IEnumerable<BarangayPharmaSystem.Areas.Staff.Models.StaffPatientListViewModel>
@{
    ViewData["Title"] = "Patient Management";
}

<div class="bps-page-header">
    <div>
        <h1 class="bps-page-title">Patient Management</h1>
        <p class="bps-page-subtitle">Track, register, and update patient directories</p>
    </div>
    <div class="bps-nav-actions">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> Add New Patient
        </a>
    </div>
</div>

<div class="bps-card mb-4">
    <div class="bps-card-header bg-white d-flex flex-wrap align-items-center justify-content-between gap-3 p-3 border-bottom">
        <h3 class="bps-card-title text-primary mb-0"><i class="bi bi-people-fill me-2"></i> Patient Directory</h3>
        
        <form method="get" asp-action="Index" class="d-flex gap-2 flex-grow-1 flex-md-grow-0" style="max-width: 400px;">
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="search" value="@ViewData["SearchQuery"]" class="form-control bg-light border-start-0" placeholder="Search by name, ID..." aria-label="Search">
                <button class="btn btn-primary" type="submit">Search</button>
            </div>
            @if (!string.IsNullOrEmpty(ViewData["SearchQuery"]?.ToString()))
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
            }
        </form>
    </div>
    
    @if (!Model.Any())
    {
        <div class="bps-empty-state p-5">
            <i class="bi bi-people bps-empty-state-icon bps-empty-state-icon-float text-primary" style="opacity: 0.4;"></i>
            <div class="bps-empty-state-title">No Patients Found</div>
            <p class="bps-empty-state-subtitle">
                @if (!string.IsNullOrEmpty(ViewData["SearchQuery"]?.ToString()))
                {
                    <text>No patients match your search query "@ViewData["SearchQuery"]".</text>
                }
                else
                {
                    <text>There are no patients registered in the directory yet. Click below to add one.</text>
                }
            </p>
            <div class="d-flex gap-2">
                @if (!string.IsNullOrEmpty(ViewData["SearchQuery"]?.ToString()))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">Reset Search</a>
                }
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-lg me-1"></i>Add New Patient
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 70px;" class="text-center">Photo</th>
                        <th>Patient ID</th>
                        <th>Full Name</th>
                        <th>Contact</th>
                        <th>Age</th>
                        <th class="text-center">Account</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var accountBadge = item.HasLinkedAccount ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning text-dark";
                        
                        <tr>
                            <td class="text-center">
                                <div class="bps-nav-avatar mx-auto" style="width: 40px; height: 40px; background: var(--bps-primary-subtle); color: var(--bps-primary); border-radius: var(--bps-radius-full);">
                                    @if (!string.IsNullOrEmpty(item.ProfilePhotoPath))
                                    {
                                        <img src="@item.ProfilePhotoPath" class="bps-profile-photo" style="width: 100%; height: 100%; object-fit: cover;" alt="Profile" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-person-fill"></i>
                                    }
                                </div>
                            </td>
                            <td class="fw-bold text-primary">@item.PatientCode</td>
                            <td class="fw-bold text-gray-900">@item.FullName</td>
                            <td class="text-secondary">@(string.IsNullOrEmpty(item.ContactNumber) ? "—" : item.ContactNumber)</td>
                            <td>@item.Age</td>
                            <td class="text-center">
                                <span class="badge @accountBadge rounded-pill px-2.5 py-1 fw-semibold">
                                    <i class="bi @(item.HasLinkedAccount ? "bi-check-circle-fill" : "bi-clock-history") me-1"></i>
                                    @(item.HasLinkedAccount ? "Linked" : "Pending")
                                </span>
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="View Profile">
                                    <i class="bi bi-folder-open"></i> Profile
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary ms-1" title="Edit Patient">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('You are about to delete the patient profile of @item.FullName. This cannot be undone. Confirm?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger ms-1" title="Delete Patient">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (TempData["PatientCodeAlert"] != null)
{
    <!-- Modal to show newly generated Patient Code -->
    <div class="modal fade show d-block" id="patientCodeModal" tabindex="-1" role="dialog" style="background: rgba(15, 23, 42, 0.6);" aria-labelledby="modalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content border-0 shadow-lg" style="border-radius: var(--bps-radius-lg);">
                <div class="modal-header text-white border-0 py-3" style="background-color: var(--bps-primary); border-top-left-radius: var(--bps-radius-lg); border-top-right-radius: var(--bps-radius-lg);">
                    <h5 class="modal-title fw-bold" id="modalLabel"><i class="bi bi-person-vcard me-2"></i>Patient Profile Created</h5>
                    <button type="button" class="btn-close btn-close-white" onclick="document.getElementById('patientCodeModal').classList.remove('d-block'); document.getElementById('patientCodeModal').style.display='none'" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center py-4 px-4">
                    <p class="mb-2 text-secondary">Please provide this Patient ID to the patient.</p>
                    <p class="small text-muted mb-4">They will need it to register their online account.</p>
                    <h2 class="fw-bold text-primary mb-4 p-3 bg-light rounded border border-primary-subtle" style="letter-spacing: 2px; font-family: var(--bps-font-heading);">
                        <span id="pCode">@TempData["PatientCodeAlert"]</span>
                    </h2>
                    <div class="d-flex justify-content-center gap-2">
                        <button class="btn btn-outline-primary" onclick="navigator.clipboard.writeText(document.getElementById('pCode').innerText); alert('Copied to clipboard!');">
                            <i class="bi bi-copy me-1"></i> Copy Code
                        </button>
                        <button class="btn btn-primary" onclick="window.print()">
                            <i class="bi bi-printer me-1"></i> Print Stub
                        </button>
                    </div>
                </div>
                <div class="modal-footer border-0 pb-3 justify-content-center">
                    <button type="button" class="btn btn-secondary px-4" onclick="document.getElementById('patientCodeModal').classList.remove('d-block'); document.getElementById('patientCodeModal').style.display='none'">Dismiss</button>
                </div>
            </div>
        </div>
    </div>
}
