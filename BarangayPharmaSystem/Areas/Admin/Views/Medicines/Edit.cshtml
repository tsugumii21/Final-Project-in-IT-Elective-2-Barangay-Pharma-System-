@model BarangayPharmaSystem.Areas.Admin.Models.MedicineFormViewModel
@{
    ViewData["Title"] = "Edit Medicine";
}

<div class="bps-page-header">
    <div>
        <h1 class="bps-page-title">Edit Medicine</h1>
        <p class="bps-page-subtitle">Update inventory details, stock levels, or expiry dates</p>
    </div>
    <div class="bps-nav-actions">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="bps-card">
            <div class="bps-card-body p-4">
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="CurrentPhotoPath" />

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger mb-4">
                            <div asp-validation-summary="All" class="mb-0 small fw-bold"></div>
                        </div>
                    }

                    <div class="row g-3 mb-4">
                        <div class="col-md-8">
                            <label asp-for="Name" class="form-label">Medicine Name <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        
                        <div class="col-md-4">
                            <label asp-for="Category" class="form-label">Category <span class="text-danger">*</span></label>
                            <select asp-for="Category" class="form-select">
                                <option value="">Select...</option>
                                <option value="Analgesic">Analgesic (Pain Reliever)</option>
                                <option value="Antibiotic">Antibiotic</option>
                                <option value="Antihistamine">Antihistamine</option>
                                <option value="Vitamins">Vitamins / Supplements</option>
                                <option value="First Aid">First Aid</option>
                                <option value="Other">Other</option>
                            </select>
                            <span asp-validation-for="Category" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Stock" class="form-label">Current Stock Quantity <span class="text-danger">*</span></label>
                            <input asp-for="Stock" class="form-control" type="number" min="0" />
                            <span asp-validation-for="Stock" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="MinStockLevel" class="form-label">Low Stock Threshold <span class="text-danger">*</span></label>
                            <input asp-for="MinStockLevel" class="form-control" type="number" min="0" />
                            <span asp-validation-for="MinStockLevel" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="ExpiryDate" class="form-label">Expiry Date <span class="text-danger">*</span></label>
                            <input asp-for="ExpiryDate" class="form-control" type="date" />
                            <span asp-validation-for="ExpiryDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="DosageInfo" class="form-label">Dosage & Instructions</label>
                            <input asp-for="DosageInfo" class="form-control" />
                            <span asp-validation-for="DosageInfo" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="SupplierId" class="form-label">Supplier / Vendor</label>
                            <select asp-for="SupplierId" class="form-select" asp-items="Model.SuppliersList">
                                <option value="">-- No Supplier Selected --</option>
                            </select>
                            <span asp-validation-for="SupplierId" class="text-danger small"></span>
                        </div>

                        <div class="col-12 d-flex gap-3 align-items-center mt-3">
                            <div class="bps-nav-avatar" style="width:64px;height:64px;background:var(--bps-gray-200);color:var(--bps-gray-500);font-size:2rem;flex-shrink:0;border-radius:var(--bps-radius-md);">
                                @if (!string.IsNullOrEmpty(Model.CurrentPhotoPath))
                                {
                                    <img src="@Model.CurrentPhotoPath" alt="Photo" style="width:100%;height:100%;border-radius:var(--bps-radius-md);object-fit:cover;" />
                                }
                                else
                                {
                                    <i class="bi bi-capsule"></i>
                                }
                            </div>
                            <div class="flex-grow-1">
                                <label asp-for="PhotoFile" class="form-label">Update Medicine Photo</label>
                                <input asp-for="PhotoFile" class="form-control form-control-sm" type="file" accept=".jpg,.jpeg,.png" />
                                <div class="form-text">Leave blank to keep current photo. Max 2MB.</div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 fw-bold">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
