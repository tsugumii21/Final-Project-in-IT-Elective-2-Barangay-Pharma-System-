@model BarangayPharmaSystem.Areas.Admin.Models.ReportsViewModel
@{
    ViewData["Title"] = "System Reports";
}

<div class="bps-page-header">
    <div>
        <h1 class="bps-page-title">Reports & Analytics</h1>
        <p class="bps-page-subtitle">View dispensing statistics, usage reports, and patient activity</p>
    </div>
    <div class="bps-nav-actions">
        <button type="button" class="btn btn-outline-primary" onclick="window.print()">
            <i class="bi bi-printer"></i> Print Report
        </button>
    </div>
</div>

<!-- Date Filter -->
<div class="bps-card mb-4 d-print-none">
    <div class="bps-card-body p-3">
        <form method="get" class="d-flex flex-wrap gap-3 align-items-end">
            <div>
                <label class="form-label small text-muted mb-1">Start Date</label>
                <input type="date" name="startDate" class="form-control form-control-sm bg-light" value="@Model.StartDate.ToString("yyyy-MM-dd")" />
            </div>
            <div>
                <label class="form-label small text-muted mb-1">End Date</label>
                <input type="date" name="endDate" class="form-control form-control-sm bg-light" value="@Model.EndDate.ToString("yyyy-MM-dd")" />
            </div>
            <div>
                <button type="submit" class="btn btn-sm btn-primary">Generate Report</button>
            </div>
        </form>
    </div>
</div>

<!-- Quick Stats -->
<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="bps-stat-card bps-stat-xl bg-primary text-white" style="border:none;">
            <div class="bps-stat-icon" style="background:rgba(255,255,255,0.2);color:#fff;">
                <i class="bi bi-box-seam-fill"></i>
            </div>
            <div class="bps-stat-content">
                <div class="bps-stat-value text-white">@Model.TotalDispensedRecords</div>
                <div class="bps-stat-label text-white-50">Total Dispensing Transactions</div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="bps-stat-card bps-stat-xl bg-success text-white" style="border:none;">
            <div class="bps-stat-icon" style="background:rgba(255,255,255,0.2);color:#fff;">
                <i class="bi bi-capsule"></i>
            </div>
            <div class="bps-stat-content">
                <div class="bps-stat-value text-white">@Model.TotalMedicinesDispensed</div>
                <div class="bps-stat-label text-white-50">Total Medicine Units Dispensed</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Top Medicines -->
    <div class="col-lg-6">
        <div class="bps-card h-100">
            <div class="bps-card-header">
                <h3 class="bps-card-title"><i class="bi bi-graph-up-arrow text-primary me-2"></i> Top Dispensed Medicines</h3>
            </div>
            <div class="bps-card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th>Medicine</th>
                            <th>Category</th>
                            <th class="text-end">Units Dispensed</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.TopMedicines.Any())
                        {
                            <tr><td colspan="3" class="text-center text-muted py-3">No data for selected period</td></tr>
                        }
                        @foreach (var med in Model.TopMedicines)
                        {
                            <tr>
                                <td class="fw-bold text-primary">@med.MedicineName</td>
                                <td>@med.Category</td>
                                <td class="text-end fw-bold">@med.TotalDispensed</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Active Patients -->
    <div class="col-lg-6">
        <div class="bps-card h-100">
            <div class="bps-card-header">
                <h3 class="bps-card-title"><i class="bi bi-people-fill text-success me-2"></i> Most Active Patients</h3>
            </div>
            <div class="bps-card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th>Patient ID</th>
                            <th>Name</th>
                            <th class="text-end">Total Visits</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.TopPatients.Any())
                        {
                            <tr><td colspan="3" class="text-center text-muted py-3">No patient data</td></tr>
                        }
                        @foreach (var p in Model.TopPatients)
                        {
                            <tr>
                                <td><span class="badge bg-secondary">@p.PatientCode</span></td>
                                <td class="fw-bold">@p.PatientName</td>
                                <td class="text-end fw-bold">@(p.DispensingCount + p.PrescriptionsCount)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Low Stock Overview -->
<div class="bps-card">
    <div class="bps-card-header bg-danger bg-opacity-10">
        <h3 class="bps-card-title text-danger"><i class="bi bi-exclamation-octagon-fill me-2"></i> Low Stock & Out of Stock Report</h3>
    </div>
    <div class="bps-card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="bg-light">
                <tr>
                    <th>Medicine</th>
                    <th>Current Stock</th>
                    <th>Min Threshold</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.LowStockMedicines.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">
                            <i class="bi bi-check-circle-fill text-success fs-2 d-block mb-2"></i>
                            All medicine stocks are at healthy levels.
                        </td>
                    </tr>
                }
                @foreach (var low in Model.LowStockMedicines)
                {
                    <tr>
                        <td class="fw-bold">@low.MedicineName</td>
                        <td class="fw-bold @(low.CurrentStock <= 0 ? "text-danger" : "text-warning")">@low.CurrentStock</td>
                        <td>@low.MinStockLevel</td>
                        <td>
                            @if (low.CurrentStock <= 0)
                            {
                                <span class="badge bg-danger">@low.Status</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">@low.Status</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
