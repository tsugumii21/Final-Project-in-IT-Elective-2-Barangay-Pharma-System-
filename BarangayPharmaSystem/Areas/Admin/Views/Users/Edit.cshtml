@model BarangayPharmaSystem.Areas.Admin.Models.UserEditViewModel
@{
    ViewData["Title"] = "Edit User";
}

<div class="bps-page-header">
    <div>
        <h1 class="bps-page-title">Edit User</h1>
        <p class="bps-page-subtitle">Update account details and role</p>
    </div>
    <div class="bps-nav-actions">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="bps-card">
            <div class="bps-card-body p-4">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger mb-4">
                        <div asp-validation-summary="All" class="mb-0 small fw-bold"></div>
                    </div>
                }

                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="CurrentPhotoPath" />
                    
                    <h5 class="fw-bold mb-3 border-bottom pb-2">Account Details</h5>
                    
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Role" class="form-label">Role <span class="text-danger">*</span></label>
                            <select asp-for="Role" class="form-select" id="roleSelector">
                                <option value="Admin">Admin</option>
                                <option value="Staff">Staff</option>
                                <option value="Patient">Patient</option>
                            </select>
                            <span asp-validation-for="Role" class="text-danger small"></span>
                        </div>
                        
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label">Email Address <span class="text-danger">*</span></label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-12 d-flex gap-3 align-items-center mt-3">
                            <div class="bps-nav-avatar" style="width:64px;height:64px;background:var(--bps-gray-200);color:var(--bps-gray-500);font-size:2rem;flex-shrink:0;">
                                @if (!string.IsNullOrEmpty(Model.CurrentPhotoPath))
                                {
                                    <img src="@Model.CurrentPhotoPath" alt="Profile" style="width:100%;height:100%;border-radius:50%;object-fit:cover;" />
                                }
                                else
                                {
                                    <i class="bi bi-person-fill"></i>
                                }
                            </div>
                            <div class="flex-grow-1">
                                <label asp-for="ProfilePhoto" class="form-label">Update Profile Photo</label>
                                <input asp-for="ProfilePhoto" class="form-control form-control-sm" type="file" accept=".jpg,.jpeg,.png" />
                                <div class="form-text">Leave blank to keep current photo. Max 2MB.</div>
                            </div>
                        </div>
                    </div>

                    <h5 class="fw-bold mb-3 border-bottom pb-2">Personal Information</h5>
                    
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label">Full Name <span class="text-danger">*</span></label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        
                        <div class="col-md-6">
                            <label asp-for="ContactNumber" class="form-label">Contact Number</label>
                            <input asp-for="ContactNumber" class="form-control" />
                            <span asp-validation-for="ContactNumber" class="text-danger small"></span>
                        </div>
                    </div>

                    <div id="patientFields" style="display: none;">
                        <h5 class="fw-bold mb-3 border-bottom pb-2 text-success">
                            <i class="bi bi-person-vcard-fill me-2"></i>Patient Profile Data
                        </h5>
                        
                        @if (!string.IsNullOrEmpty(Model.PatientCode))
                        {
                            <div class="mb-3">
                                <label class="form-label text-muted">Patient ID</label>
                                <input type="text" class="form-control bg-light" value="@Model.PatientCode" readonly />
                                <input type="hidden" asp-for="PatientCode" />
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning border-warning border-opacity-25 py-2 px-3 mb-3 small">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i> User does not have a Patient ID yet. One will be generated upon saving.
                            </div>
                        }

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="Birthdate" class="form-label">Date of Birth <span class="text-danger">*</span></label>
                                <input asp-for="Birthdate" class="form-control" type="date" />
                                <span asp-validation-for="Birthdate" class="text-danger small"></span>
                            </div>
                            
                            <div class="col-12">
                                <label asp-for="Address" class="form-label">Home Address</label>
                                <input asp-for="Address" class="form-control" />
                                <span asp-validation-for="Address" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 fw-bold">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const roleSelector = document.getElementById("roleSelector");
            const patientFields = document.getElementById("patientFields");

            function toggleFields() {
                if (roleSelector.value === "Patient") {
                    patientFields.style.display = "block";
                } else {
                    patientFields.style.display = "none";
                }
            }

            roleSelector.addEventListener("change", toggleFields);
            toggleFields();
        });
    </script>
}
