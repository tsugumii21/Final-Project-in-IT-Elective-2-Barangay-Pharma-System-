@model BarangayPharmaSystem.Areas.Admin.Models.UserCreateViewModel
@{
    ViewData["Title"] = "Create User";
}

<div class="bps-page-header">
    <div>
        <h1 class="bps-page-title">Add New User</h1>
        <p class="bps-page-subtitle">Create a new Admin, Staff, or Patient account</p>
    </div>
    <div class="bps-nav-actions">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="bps-card">
            <div class="bps-card-body p-4">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger mb-4">
                        <div asp-validation-summary="All" class="mb-0 small fw-bold"></div>
                    </div>
                }

                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    <h5 class="fw-bold mb-3 border-bottom pb-2">Account Details</h5>
                    
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Role" class="form-label">Role <span class="text-danger">*</span></label>
                            <select asp-for="Role" class="form-select" id="roleSelector">
                                <option value="Admin">Admin</option>
                                <option value="Staff" selected>Staff</option>
                                <option value="Patient">Patient</option>
                            </select>
                            <span asp-validation-for="Role" class="text-danger small"></span>
                        </div>
                        
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label">Email Address <span class="text-danger">*</span></label>
                            <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label">Password <span class="text-danger">*</span></label>
                            <input asp-for="Password" class="form-control" placeholder="••••••••" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ProfilePhoto" class="form-label">Profile Photo</label>
                            <input asp-for="ProfilePhoto" class="form-control" type="file" accept=".jpg,.jpeg,.png" />
                            <span asp-validation-for="ProfilePhoto" class="text-danger small"></span>
                            <div class="form-text">Max 2MB. Allowed: JPG, PNG.</div>
                        </div>
                    </div>

                    <h5 class="fw-bold mb-3 border-bottom pb-2">Personal Information</h5>
                    
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label">Full Name <span class="text-danger">*</span></label>
                            <input asp-for="FullName" class="form-control" placeholder="Juan dela Cruz" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        
                        <div class="col-md-6">
                            <label asp-for="ContactNumber" class="form-label">Contact Number</label>
                            <input asp-for="ContactNumber" class="form-control" placeholder="0917 123 4567" />
                            <span asp-validation-for="ContactNumber" class="text-danger small"></span>
                        </div>
                    </div>

                    <div id="patientFields" style="display: none;">
                        <h5 class="fw-bold mb-3 border-bottom pb-2 text-success">
                            <i class="bi bi-person-vcard-fill me-2"></i>Patient Profile Data
                        </h5>
                        <div class="alert alert-success-subtle border-success border-opacity-25 py-2 px-3 mb-3 small">
                            <i class="bi bi-info-circle-fill me-1"></i> A unique Patient ID will be automatically generated upon creation.
                        </div>
                        
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="Birthdate" class="form-label">Date of Birth <span class="text-danger">*</span></label>
                                <input asp-for="Birthdate" class="form-control" type="date" />
                                <span asp-validation-for="Birthdate" class="text-danger small"></span>
                            </div>
                            
                            <div class="col-12">
                                <label asp-for="Address" class="form-label">Home Address</label>
                                <input asp-for="Address" class="form-control" placeholder="123 Main St, Barangay..." />
                                <span asp-validation-for="Address" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 fw-bold">Create User</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const roleSelector = document.getElementById("roleSelector");
            const patientFields = document.getElementById("patientFields");

            function toggleFields() {
                if (roleSelector.value === "Patient") {
                    patientFields.style.display = "block";
                } else {
                    patientFields.style.display = "none";
                }
            }

            roleSelector.addEventListener("change", toggleFields);
            toggleFields(); // run on load in case of validation fail redirect
        });
    </script>
}
