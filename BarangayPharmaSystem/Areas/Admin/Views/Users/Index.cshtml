@model IEnumerable<BarangayPharmaSystem.Areas.Admin.Models.UserListViewModel>
@{
    ViewData["Title"] = "User Management";
}

<div class="bps-page-header">
    <div>
        <h1 class="bps-page-title">User Management</h1>
        <p class="bps-page-subtitle">Manage administrators, staff, and patients</p>
    </div>
    <div class="bps-nav-actions">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Add New User
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="bps-alert bps-alert-success">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="bps-alert bps-alert-error">
        <i class="bi bi-x-circle-fill me-2"></i> @TempData["ErrorMessage"]
    </div>
}
@if (TempData["PatientCodeAlert"] != null)
{
    <div class="alert alert-info border-0 shadow-sm d-flex align-items-center">
        <i class="bi bi-info-circle-fill fs-4 me-3 text-info"></i>
        <div>
            <h6 class="mb-1 fw-bold">Patient Created Successfully</h6>
            <p class="mb-0">Please provide this Patient ID to the user for registration: <strong class="fs-5 text-primary">@TempData["PatientCodeAlert"]</strong></p>
        </div>
    </div>
}

<div class="bps-card mb-4">
    <div class="bps-card-header bg-white">
        <form method="get" class="d-flex w-100 gap-2 align-items-center" style="max-width: 400px;">
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="search" class="form-control border-start-0 bg-light" placeholder="Search by name or email..." value="@ViewData["SearchQuery"]" />
            </div>
            <button type="submit" class="btn btn-outline-primary">Search</button>
            @if (!string.IsNullOrEmpty(ViewData["SearchQuery"]?.ToString()))
            {
                <a asp-action="Index" class="btn btn-link text-muted px-0">Clear</a>
            }
        </form>
    </div>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th style="width: 50px;"></th>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2 text-black-50"></i>
                            No users found.
                        </td>
                    </tr>
                }
                @foreach (var user in Model)
                {
                    var badgeClass = user.Role switch {
                        "Admin" => "bg-danger",
                        "Staff" => "bg-primary",
                        "Patient" => "bg-success",
                        _ => "bg-secondary"
                    };

                    <tr>
                        <td>
                            <div class="bps-nav-avatar" style="width:36px;height:36px;background:var(--bps-primary-subtle);color:var(--bps-primary);font-size:1.2rem;">
                                @if (!string.IsNullOrEmpty(user.ProfilePhotoPath))
                                {
                                    <img src="@user.ProfilePhotoPath" alt="Profile" style="width:100%;height:100%;border-radius:50%;object-fit:cover;" />
                                }
                                else
                                {
                                    <i class="bi bi-person-fill"></i>
                                }
                            </div>
                        </td>
                        <td class="fw-bold">@user.FullName</td>
                        <td>@user.Email</td>
                        <td><span class="badge @badgeClass">@user.Role</span></td>
                        <td>
                            <span class="badge bg-success-subtle text-success">Active</span>
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <button type="button" class="btn btn-sm btn-outline-danger ms-1" data-bs-toggle="modal" data-bs-target="#deleteModal-@user.Id">
                                <i class="bi bi-trash"></i> Delete
                            </button>
                        </td>
                    </tr>

                    <!-- Delete Modal -->
                    <div class="modal fade" id="deleteModal-@user.Id" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content border-0 shadow">
                                <div class="modal-header border-bottom-0 pb-0">
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body text-center pb-4">
                                    <i class="bi bi-exclamation-triangle-fill text-danger fs-1 mb-3"></i>
                                    <h4 class="fw-bold">Delete User</h4>
                                    <p class="text-muted">Are you sure you want to delete <strong>@user.FullName</strong>? This action cannot be undone.</p>
                                    
                                    <form asp-action="Delete" asp-route-id="@user.Id" method="post" class="mt-4">
                                        <button type="button" class="btn btn-light me-2" data-bs-dismiss="modal">Cancel</button>
                                        <button type="submit" class="btn btn-danger">Yes, delete user</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </tbody>
        </table>
    </div>
</div>
