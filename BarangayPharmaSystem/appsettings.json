{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost\\SQLEXPRESS;Database=BarangayPharmaDB;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AppSettings": {
    "MaxUploadSizeBytes": 2097152,
    "AllowedImageExtensions": [ ".jpg", ".jpeg", ".png" ],
    "PatientPhotosFolder": "uploads/patients",
    "MedicinePhotosFolder": "uploads/medicines",
    "UserPhotosFolder": "uploads/users",
    "StockAlertExpiryDaysThreshold": 30,
    "RefillCooldownDays": 7
  }
}
