<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Barangay Pharma System — Pharmacy management for barangay health centers." />
    <title>@ViewData["Title"] — Barangay Pharma System</title>

    <!-- Google Fonts: DM Sans (headings) + Nunito (body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Nunito:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <!-- Application CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bps-app-body">

@{
    // Retrieve the logged-in user's profile photo path from claims / ViewData
    var userPhoto = User.FindFirst("ProfilePhotoPath")?.Value
                 ?? ViewData["UserProfilePhoto"]?.ToString();
    var userFullName = User.Identity?.Name ?? "User";
}

@if (User.Identity?.IsAuthenticated == true)
{
    @* ═══════════════════════════════════════════════════════════════════════
       AUTHENTICATED LAYOUT — Sidebar + Navbar
    ═══════════════════════════════════════════════════════════════════════ *@

    <div class="bps-wrapper">

        <!-- ── Sidebar ─────────────────────────────────────────────────── -->
        <aside id="bps-sidebar" class="bps-sidebar">
            <!-- Brand -->
            <div class="bps-sidebar-brand">
                <div class="bps-brand-icon">
                    <i class="bi bi-hospital-fill"></i>
                </div>
                <div class="bps-brand-text">
                    <span class="bps-brand-title">BPS</span>
                    <span class="bps-brand-subtitle">Pharma System</span>
                </div>
            </div>

            <!-- Navigation -->
            <nav class="bps-sidebar-nav">
                @await Html.PartialAsync("_SidebarPartial")
            </nav>

            <!-- Sidebar footer with user info -->
            <div class="bps-sidebar-footer">
                <div class="bps-sidebar-user-info">
                    <div class="bps-sidebar-avatar">
                        @if (!string.IsNullOrEmpty(userPhoto))
                        {
                            <img src="@userPhoto" alt="@userFullName" class="bps-avatar-img" />
                        }
                        else
                        {
                            <i class="bi bi-person-circle"></i>
                        }
                    </div>
                    <div class="bps-sidebar-user-meta">
                        <span class="bps-sidebar-user-name">@userFullName</span>
                        <span class="bps-sidebar-user-role">
                            @if (User.IsInRole("Admin")) { <text>Administrator</text> }
                            else if (User.IsInRole("Staff")) { <text>Staff Member</text> }
                            else { <text>Patient</text> }
                        </span>
                    </div>
                </div>
            </div>
        </aside>

        <!-- ── Main content area ──────────────────────────────────────── -->
        <div class="bps-main">

            <!-- Top Navbar -->
            <header class="bps-navbar">
                <!-- Sidebar toggle (mobile) -->
                <button id="bps-sidebar-toggle" class="bps-nav-toggle" type="button"
                        aria-label="Toggle sidebar" aria-expanded="false" aria-controls="bps-sidebar">
                    <i class="bi bi-list"></i>
                </button>

                <!-- Right-side nav items -->
                <div class="bps-nav-actions">

                    <!-- Patient notification bell (Patients only) -->
                    @if (User.IsInRole("Patient"))
                    {
                        var notifCount = ViewData["PatientNotifCount"] as int? ?? 0;
                        <div class="dropdown" id="patient-notif-dropdown-wrap">
                            <button class="bps-nav-icon-btn @(notifCount > 0 ? "bps-has-badge" : "") dropdown-toggle"
                                    type="button" id="patientNotifBtn"
                                    data-bs-toggle="dropdown" data-bs-auto-close="outside"
                                    aria-expanded="false" title="Notifications"
                                    style="border:none; background:none;">
                                <i class="bi bi-bell-fill"></i>
                                @if (notifCount > 0)
                                {
                                    <span class="bps-badge bps-badge-notif">@(notifCount > 9 ? "9+" : notifCount.ToString())</span>
                                }
                            </button>
                            <div class="dropdown-menu dropdown-menu-end bps-notif-dropdown" aria-labelledby="patientNotifBtn">
                                <div class="bps-notif-header">
                                    <span class="bps-notif-title"><i class="bi bi-bell-fill me-2"></i>Notifications</span>
                                    @if (notifCount > 0)
                                    {
                                        <span class="bps-notif-count-pill">@notifCount new</span>
                                    }
                                </div>
                                <div class="bps-notif-body" id="patient-notif-list">
                                    @{
                                        var notifItems = ViewData["PatientNotifications"] as List<(string Icon, string Color, string Text, string Sub)>;
                                    }
                                    @if (notifItems != null && notifItems.Any())
                                    {
                                        foreach (var n in notifItems)
                                        {
                                            <div class="bps-notif-item">
                                                <div class="bps-notif-icon" style="background: @n.Color + "1a"; color: @n.Color;">
                                                    <i class="bi @n.Icon"></i>
                                                </div>
                                                <div class="bps-notif-text">
                                                    <div class="bps-notif-main">@n.Text</div>
                                                    @if (!string.IsNullOrEmpty(n.Sub))
                                                    {
                                                        <div class="bps-notif-sub">@n.Sub</div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="bps-notif-empty">
                                            <i class="bi bi-check-circle-fill"></i>
                                            <span>You're all caught up!</span>
                                        </div>
                                    }
                                </div>
                                <div class="bps-notif-footer">
                                    <a href="/Patient/Refills" class="bps-notif-link">View all refill requests</a>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- User dropdown -->
                    <div class="dropdown">
                        <button class="bps-nav-user-btn dropdown-toggle" type="button"
                                id="navUserDropdown" data-bs-toggle="dropdown"
                                aria-expanded="false">
                            <div class="bps-nav-avatar">
                                @if (!string.IsNullOrEmpty(userPhoto))
                                {
                                    <img src="@userPhoto" alt="@userFullName" class="bps-avatar-img" />
                                }
                                else
                                {
                                    <i class="bi bi-person-fill"></i>
                                }
                            </div>
                            <div class="d-none d-md-flex flex-column align-items-start">
                                @{
                                    var hour = DateTime.Now.Hour;
                                    var greeting = hour < 12 ? "Good morning" : hour < 18 ? "Good afternoon" : "Good evening";
                                    var firstName = userFullName.Split(' ')[0];
                                }
                                <span class="bps-nav-username">@greeting, @firstName!</span>
                                <span class="bps-nav-user-role-badge">
                                    @if (User.IsInRole("Admin")) { <text>Admin</text> }
                                    else if (User.IsInRole("Staff")) { <text>Staff</text> }
                                    else { <text>Patient</text> }
                                </span>
                            </div>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end bps-user-dropdown" aria-labelledby="navUserDropdown">
                            <li>
                                <div class="bps-dropdown-user-info px-3 py-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="bps-dropdown-avatar">
                                            @if (!string.IsNullOrEmpty(userPhoto))
                                            {
                                                <img src="@userPhoto" alt="@userFullName" class="bps-avatar-img" />
                                            }
                                            else
                                            {
                                                <i class="bi bi-person-circle" style="font-size: 1.5rem; color: var(--bps-primary);"></i>
                                            }
                                        </div>
                                        <div>
                                            <div class="fw-semibold" style="font-size: 0.875rem; color: var(--bps-gray-800);">@userFullName</div>
                                            <span class="bps-role-badge-pill">
                                                @if (User.IsInRole("Admin")) { <text>Administrator</text> }
                                                else if (User.IsInRole("Staff")) { <text>Staff Member</text> }
                                                else { <text>Patient</text> }
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                @if (User.IsInRole("Patient"))
                                {
                                    <a class="dropdown-item" href="/Patient/Profile" id="nav-profile">
                                        <i class="bi bi-person-circle me-2"></i> My Profile
                                    </a>
                                }
                                else if (User.IsInRole("Staff"))
                                {
                                    <a class="dropdown-item" href="/Staff/Dashboard" id="nav-profile">
                                        <i class="bi bi-grid-1x2-fill me-2"></i> My Dashboard
                                    </a>
                                }
                                else
                                {
                                    <a class="dropdown-item" href="/Admin/Dashboard" id="nav-profile">
                                        <i class="bi bi-grid-1x2-fill me-2"></i> My Dashboard
                                    </a>
                                }
                            </li>
                            <li>
                                <a class="dropdown-item" href="/Account/ChangePassword" id="nav-change-password">
                                    <i class="bi bi-shield-lock me-2"></i> Change Password
                                </a>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" id="logout-form">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item bps-logout-btn" id="nav-logout">
                                        <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <!-- Page content -->
            <main class="bps-content">
                <!-- Toast notifications -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="bps-alert bps-alert-success alert-dismissible fade show" role="alert" id="toast-success">
                        <i class="bi bi-check-circle-fill me-2"></i>
                        @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="bps-alert bps-alert-error alert-dismissible fade show" role="alert" id="toast-error">
                        <i class="bi bi-exclamation-circle-fill me-2"></i>
                        @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["WarningMessage"] != null)
                {
                    <div class="bps-alert bps-alert-warning alert-dismissible fade show" role="alert" id="toast-warning">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        @TempData["WarningMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>
}
else
{
    @* ═══════════════════════════════════════════════════════════════════════
       UNAUTHENTICATED LAYOUT — with Public Navbar (for SDG3, About, Login)
    ═══════════════════════════════════════════════════════════════════════ *@

    <!-- Public Navbar -->
    <nav class="bps-public-navbar">
        <div class="bps-public-navbar-inner">
            <a href="/" class="bps-public-brand">
                <div class="bps-public-brand-icon">
                    <i class="bi bi-hospital-fill"></i>
                </div>
                <span class="bps-public-brand-text">Barangay Pharma System</span>
            </a>
            <div class="bps-public-nav-links">
                <a href="/Home/SDG3" class="bps-public-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "SDG3" ? "active" : "")">
                    <i class="bi bi-globe me-1"></i> SDG 3
                </a>
                <a href="/Home/About" class="bps-public-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "About" ? "active" : "")">
                    <i class="bi bi-info-circle me-1"></i> About
                </a>
                <a href="/Account/Login" class="bps-public-nav-btn">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Login
                </a>
            </div>
        </div>
    </nav>

    <main class="bps-auth-page @ViewData["AuthPageClass"]">
        @RenderBody()
    </main>
}

<!-- Bootstrap 5 JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>

<!-- Application JS -->
<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
