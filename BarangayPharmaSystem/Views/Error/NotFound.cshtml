@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Page Not Found";
}

<div class="d-flex flex-column align-items-center justify-content-center" style="min-height: 60vh; text-align: center; padding: 2rem;">
    <div style="font-size: 6rem; line-height: 1; color: var(--bps-primary); opacity: 0.15; font-family: var(--bps-font-heading); font-weight: 900; margin-bottom: -1rem;">404</div>
    <div style="background: var(--bps-primary-subtle); border-radius: 50%; width: 80px; height: 80px; display: flex; align-items: center; justify-content: center; margin-bottom: 1.5rem;">
        <i class="bi bi-map" style="font-size: 2rem; color: var(--bps-primary);"></i>
    </div>
    <h1 class="h3 mb-2" style="font-family: var(--bps-font-heading); font-weight: 700; color: var(--bps-gray-800);">Page Not Found</h1>
    <p class="mb-4" style="color: var(--bps-gray-500); max-width: 400px; line-height: 1.7;">
        The page you're looking for doesn't exist or has been moved. 
        Please check the URL or return to the dashboard.
    </p>
    <div class="d-flex gap-3 flex-wrap justify-content-center">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a href="javascript:history.back()" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-2"></i> Go Back
            </a>
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary" style="background-color: var(--bps-primary); border-color: var(--bps-primary);">
                <i class="bi bi-house-door-fill me-2"></i> Back to Dashboard
            </a>
        }
        else
        {
            <a href="/Account/Login" class="btn btn-primary" style="background-color: var(--bps-primary); border-color: var(--bps-primary);">
                <i class="bi bi-box-arrow-in-right me-2"></i> Go to Login
            </a>
        }
    </div>
</div>
