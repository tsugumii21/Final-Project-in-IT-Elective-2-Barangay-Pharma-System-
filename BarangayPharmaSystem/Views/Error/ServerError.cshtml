@{
    Layout = "~/Views/Shared/_ErrorLayout.cshtml";
    ViewData["Title"] = "Server Error";
}

<div style="font-size: 7rem; line-height: 1; font-family: 'DM Sans', sans-serif; font-weight: 900; color: #D97706; opacity: 0.12; margin-bottom: -1.5rem;">500</div>

<div style="width: 80px; height: 80px; background: #FEF9EE; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem; border: 2px solid #D97706;">
    <i class="bi bi-exclamation-triangle-fill" style="font-size: 2rem; color: #D97706;"></i>
</div>

<h1 style="font-family: 'DM Sans', sans-serif; font-size: 1.625rem; font-weight: 700; color: #1E293B; margin-bottom: 0.5rem;">Something Went Wrong</h1>
<p style="color: #64748B; font-size: 1rem; line-height: 1.7; margin-bottom: 2rem;">
    An unexpected error occurred while processing your request.
    Please try again or contact your administrator if the problem persists.
</p>

<div class="d-flex gap-3 justify-content-center flex-wrap">
    <a href="javascript:history.back()" class="btn btn-outline-secondary px-4">
        <i class="bi bi-arrow-left me-2"></i> Go Back
    </a>
    <a href="/Account/Login" class="btn btn-primary px-4" style="background-color: #1A6FA3; border-color: #1A6FA3;">
        <i class="bi bi-box-arrow-in-right me-2"></i> Go to Login
    </a>
</div>
