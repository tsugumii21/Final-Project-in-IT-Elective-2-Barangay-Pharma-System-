@{
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
    ViewData["Title"] = "SDG 3 — Good Health and Well-being";
}

<!-- ── Hero Banner ──────────────────────────────────────────────────────── -->
<div class="bps-sdg-hero">
    <div class="bps-sdg-hero-content">
        <div class="bps-sdg-hero-badge">
            <i class="bi bi-globe"></i>
            United Nations Sustainable Development Goals
        </div>
        <h1>Supporting SDG 3:<br />Good Health and Well-being</h1>
        <p>
            The Barangay Pharma System is built with a mission aligned to SDG Goal 3 —
            ensuring healthy lives and promoting well-being for all ages in our communities.
        </p>
    </div>
</div>

<!-- ── Section 1: What is SDG 3? ──────────────────────────────────────── -->
<section class="bps-sdg-section">
    <h2 class="bps-sdg-section-title">
        <i class="bi bi-question-circle-fill" style="color: var(--bps-primary);"></i>
        What is SDG 3?
    </h2>
    <div class="bps-sdg-section-divider"></div>

    <div class="row align-items-center g-5">
        <div class="col-lg-7">
            <p class="lead" style="color: var(--bps-gray-700); line-height: 1.8;">
                <strong>Sustainable Development Goal 3</strong> is one of the 17 goals established by the
                United Nations as part of the 2030 Agenda for Sustainable Development. It focuses on
                ensuring <em>healthy lives</em> and promoting <em>well-being</em> for all people at all ages.
            </p>
            <p style="color: var(--bps-gray-600); line-height: 1.8;">
                SDG 3 covers a wide spectrum of health concerns: from reducing maternal and child
                mortality, to combating communicable diseases, strengthening mental health systems,
                and achieving universal health coverage. It recognizes that good health is both a
                precondition and an outcome of sustainable development.
            </p>
            <p style="color: var(--bps-gray-600); line-height: 1.8;">
                In the Philippine context, SDG 3 supports Barangay Health Centers and community
                pharmacies in delivering accessible, organized, and equitable health services —
                especially in rural and underserved communities.
            </p>
        </div>
        <div class="col-lg-5 text-center">
            <div style="background: var(--bps-primary); border-radius: 16px; padding: 2.5rem; display: inline-block; box-shadow: 0 8px 32px rgba(26,111,163,0.25);">
                <div style="font-size: 5rem; line-height: 1; color: white; font-family: var(--bps-font-heading); font-weight: 900;">3</div>
                <div style="color: rgba(255,255,255,0.90); font-weight: 700; font-size: 1.125rem; margin-top: 0.5rem;">GOOD HEALTH</div>
                <div style="color: rgba(255,255,255,0.75); font-size: 0.875rem;">AND WELL-BEING</div>
                <div style="margin-top: 1.25rem; font-size: 2.5rem;">🏥</div>
            </div>
        </div>
    </div>
</section>

<!-- ── Section 2: How BPS Supports SDG 3 ──────────────────────────────── -->
<section style="background: var(--bps-primary-subtle); padding: 0;">
    <div class="bps-sdg-section">
        <h2 class="bps-sdg-section-title">
            <i class="bi bi-hospital-fill" style="color: var(--bps-primary);"></i>
            How the Barangay Pharma System Supports SDG 3
        </h2>
        <div class="bps-sdg-section-divider"></div>

        <div class="row g-4">
            <!-- Card 1 -->
            <div class="col-md-6 col-xl-4">
                <div class="bps-sdg-feature-card">
                    <div class="bps-sdg-feature-icon">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <div>
                        <h3 class="bps-sdg-feature-title">Organized Medicine Access</h3>
                        <p class="bps-sdg-feature-desc">
                            Provides structured and systematic medicine dispensing for rural barangay
                            communities, ensuring every patient receives the right medicine at the right time.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Card 2 -->
            <div class="col-md-6 col-xl-4">
                <div class="bps-sdg-feature-card">
                    <div class="bps-sdg-feature-icon">
                        <i class="bi bi-calendar-check-fill"></i>
                    </div>
                    <div>
                        <h3 class="bps-sdg-feature-title">Expiry Tracking & Safety</h3>
                        <p class="bps-sdg-feature-desc">
                            Prevents the distribution of expired medicines through automated expiry date
                            monitoring and visual alerts, protecting community health and safety.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Card 3 -->
            <div class="col-md-6 col-xl-4">
                <div class="bps-sdg-feature-card">
                    <div class="bps-sdg-feature-icon">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>
                    <div>
                        <h3 class="bps-sdg-feature-title">Stock Shortage Prevention</h3>
                        <p class="bps-sdg-feature-desc">
                            Reduces medicine shortages through real-time stock monitoring and automated
                            low-stock alerts, supporting uninterrupted healthcare delivery.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Card 4 -->
            <div class="col-md-6 col-xl-4">
                <div class="bps-sdg-feature-card">
                    <div class="bps-sdg-feature-icon">
                        <i class="bi bi-folder2-open"></i>
                    </div>
                    <div>
                        <h3 class="bps-sdg-feature-title">Digital Patient Records</h3>
                        <p class="bps-sdg-feature-desc">
                            Maintains accurate and comprehensive health records for every patient —
                            including prescriptions, dispensing history, and refill requests — in one
                            secure digital system.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Card 5 -->
            <div class="col-md-6 col-xl-4">
                <div class="bps-sdg-feature-card">
                    <div class="bps-sdg-feature-icon">
                        <i class="bi bi-wifi"></i>
                    </div>
                    <div>
                        <h3 class="bps-sdg-feature-title">Telemedicine Readiness</h3>
                        <p class="bps-sdg-feature-desc">
                            Supports telemedicine readiness by digitizing prescriptions and patient records,
                            making it easier for remote communities to participate in modern healthcare models.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Card 6 -->
            <div class="col-md-6 col-xl-4">
                <div class="bps-sdg-feature-card">
                    <div class="bps-sdg-feature-icon">
                        <i class="bi bi-shield-check-fill"></i>
                    </div>
                    <div>
                        <h3 class="bps-sdg-feature-title">Universal Health Coverage</h3>
                        <p class="bps-sdg-feature-desc">
                            Contributes to universal health coverage by enabling barangay health centers to
                            scale their pharmacy operations efficiently without additional administrative burden.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ── Section 3: About the System ────────────────────────────────────── -->
<section class="bps-sdg-section">
    <h2 class="bps-sdg-section-title">
        <i class="bi bi-capsule" style="color: var(--bps-primary);"></i>
        About the Barangay Pharma System
    </h2>
    <div class="bps-sdg-section-divider"></div>

    <div class="row g-4 align-items-start">
        <div class="col-lg-7">
            <p style="color: var(--bps-gray-700); line-height: 1.8; font-size: 1.0625rem;">
                The <strong>Barangay Pharma System (BPS)</strong> is a web-based pharmacy management solution
                designed for barangay health centers and community pharmacies in the Philippines.
                It streamlines the daily operations of pharmacy staff while empowering patients
                to track their own health records online.
            </p>
            <p style="color: var(--bps-gray-600); line-height: 1.8;">
                BPS was developed as a Final Project in IT Elective 2, with a clear purpose of
                applying modern software engineering principles to a real-world social need —
                improving access to organized healthcare at the grassroots barangay level.
            </p>
            <div class="row g-3 mt-2">
                @foreach (var feature in new[] {
                    ("bi-people-fill", "Multi-Role Access", "Admin, Staff, and Patient portals"),
                    ("bi-capsule", "Medicine Inventory", "Real-time stock and expiry tracking"),
                    ("bi-file-earmark-medical-fill", "Prescription Management", "Digital prescription creation and monitoring"),
                    ("bi-arrow-repeat", "Refill Requests", "Patient self-service with cooldown enforcement"),
                    ("bi-graph-up-arrow", "Reports & Analytics", "Admin reporting and audit logs"),
                    ("bi-shield-lock-fill", "Role-based Security", "Secure, isolated access per role"),
                })
                {
                    <div class="col-sm-6">
                        <div style="display: flex; align-items: flex-start; gap: 0.75rem;">
                            <div style="width: 36px; height: 36px; border-radius: 8px; background: var(--bps-primary-subtle); color: var(--bps-primary); display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 1rem;">
                                <i class="bi @feature.Item1"></i>
                            </div>
                            <div>
                                <div style="font-family: var(--bps-font-heading); font-weight: 600; font-size: 0.9rem; color: var(--bps-gray-800);">@feature.Item2</div>
                                <div style="font-size: 0.8125rem; color: var(--bps-gray-500);">@feature.Item3</div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
        <div class="col-lg-5">
            <div class="bps-card p-4 text-center" style="border-top: 4px solid var(--bps-primary);">
                <div style="font-size: 3rem; margin-bottom: 1rem;">🏥</div>
                <h3 style="font-family: var(--bps-font-heading); font-weight: 700; color: var(--bps-primary); font-size: 1.25rem;">
                    Barangay Pharma System
                </h3>
                <p style="font-size: 0.875rem; color: var(--bps-gray-500); margin: 0.5rem 0 1.5rem;">
                    Empowering barangay health centers through digital pharmacy management.
                </p>
                <a href="/Account/Login" class="btn btn-primary w-100" style="background-color: var(--bps-primary); border-color: var(--bps-primary);">
                    <i class="bi bi-box-arrow-in-right me-2"></i> Log In to the System
                </a>
                <div class="mt-3">
                    <a href="/Account/Register" style="font-size: 0.875rem; color: var(--bps-primary);">
                        New patient? Register here →
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
