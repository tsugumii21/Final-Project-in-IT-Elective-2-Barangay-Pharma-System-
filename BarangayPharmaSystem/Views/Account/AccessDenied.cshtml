@{
    ViewData["Title"] = "Access Denied";
}

<div class="bps-auth-card text-center">
    <div class="bps-auth-icon mx-auto mb-3 bg-danger bg-opacity-25 text-danger border border-danger">
        <i class="bi bi-x-octagon-fill"></i>
    </div>
    
    <h1 class="h3 font-weight-bold text-white mb-2">Access Denied</h1>
    <p class="text-white-50 mb-4">You do not have permission to view this page or perform this action.</p>
    
    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-light px-4 py-2 bps-btn-glow">
        <i class="bi bi-house-door me-2"></i>Return to Dashboard
    </a>
</div>
