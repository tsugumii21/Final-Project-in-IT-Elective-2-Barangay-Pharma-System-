@model BarangayPharmaSystem.Models.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5 stagger-1">
        <div class="bps-card">
            <div class="bps-card-header bg-white">
                <h2 class="bps-card-title text-primary">
                    <i class="bi bi-shield-lock-fill me-2"></i> Update Your Password
                </h2>
            </div>
            <div class="bps-card-body">
                <p class="bps-empty-state-subtitle text-muted mb-4">
                    Ensure your account is secure by using a strong password with at least 8 characters, including numbers, uppercase, lowercase, and special characters.
                </p>

                <form asp-controller="Account" asp-action="ChangePassword" method="post">
                    @Html.AntiForgeryToken()

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger border-0 bg-danger bg-opacity-10 text-danger p-3 mb-4 rounded-3" role="alert">
                            <div asp-validation-summary="All" class="mb-0 small fw-medium"></div>
                        </div>
                    }

                    <div class="mb-3">
                        <label asp-for="OldPassword" class="form-label text-secondary">Current Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-key-fill"></i></span>
                            <input asp-for="OldPassword" class="form-control border-start-0 ps-0" placeholder="Enter current password" autocomplete="current-password" />
                        </div>
                        <span asp-validation-for="OldPassword" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label text-secondary">New Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-shield-lock"></i></span>
                            <input asp-for="NewPassword" class="form-control border-start-0 ps-0" placeholder="Enter new password (min. 8 characters)" autocomplete="new-password" />
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label text-secondary">Confirm New Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-shield-lock-fill"></i></span>
                            <input asp-for="ConfirmPassword" class="form-control border-start-0 ps-0" placeholder="Re-enter new password" autocomplete="new-password" />
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="d-flex align-items-center justify-content-between gap-3 mt-4">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-circle-fill me-2"></i> Save Changes
                        </button>
                        <a href="javascript:history.back()" class="btn btn-light border">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
