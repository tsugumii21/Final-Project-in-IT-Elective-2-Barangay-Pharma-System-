@model BarangayPharmaSystem.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Log In";
}

<div class="bps-hospital-card stagger-1">
    <div class="bps-hospital-header">
        <div class="bps-hospital-icon-wrapper">
            <i class="bi bi-hospital"></i>
        </div>
        <h1>Barangay Health Center</h1>
        <p>Pharmacy Management System</p>
    </div>

    <div class="px-2">
        <div class="text-center mb-4">
            <h2 class="h5 fw-bold text-gray-800">Welcome Back</h2>
            <p class="text-muted small">Log in to manage prescriptions, inventory, and refills</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger border-0 bg-danger bg-opacity-10 text-danger p-3 mb-4 rounded-3" role="alert">
                <div asp-validation-summary="All" class="mb-0 small fw-medium"></div>
            </div>
        }

        <form asp-controller="Account" asp-action="Login" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />
            
            <div class="mb-3">
                <label asp-for="Email" class="form-label text-secondary">Email Address</label>
                <div class="input-group bps-hospital-input-group">
                    <span class="input-group-text"><i class="bi bi-envelope-fill"></i></span>
                    <input asp-for="Email" class="form-control" placeholder="name@example.com" required autocomplete="email" />
                </div>
                <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label text-secondary">Password</label>
                <div class="input-group bps-hospital-input-group">
                    <span class="input-group-text"><i class="bi bi-key-fill"></i></span>
                    <input asp-for="Password" class="form-control" placeholder="••••••••" required autocomplete="current-password" />
                    <button class="btn bps-toggle-password" type="button" data-password-toggle="Password">
                        <i class="bi bi-eye-slash"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 mb-3 mt-3">
                Log In <i class="bi bi-box-arrow-in-right ms-2"></i>
            </button>
        </form>

        <div class="bps-hospital-footer">
            <p class="mb-1 text-muted">Are you a new patient?</p>
            <a asp-controller="Account" asp-action="Register">
                Register with Patient Code <i class="bi bi-arrow-right-short"></i>
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
