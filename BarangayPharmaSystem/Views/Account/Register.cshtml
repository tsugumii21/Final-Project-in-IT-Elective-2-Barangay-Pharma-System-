@model BarangayPharmaSystem.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Patient Registration";
}

<div class="bps-hospital-card bps-hospital-card-wide stagger-1">
    <div class="bps-hospital-header">
        <div class="bps-hospital-icon-wrapper">
            <i class="bi bi-person-vcard"></i>
        </div>
        <h1>Patient Registration</h1>
        <p>Enter the Patient ID provided by your health center to activate your online account</p>
    </div>

    <div class="px-2">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger border-0 bg-danger bg-opacity-10 text-danger p-3 mb-4 rounded-3" role="alert">
                <div asp-validation-summary="All" class="mb-0 small fw-medium"></div>
            </div>
        }

        <form asp-controller="Account" asp-action="Register" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="PatientCode" class="form-label text-secondary">Patient ID</label>
                    <div class="input-group bps-hospital-input-group">
                        <span class="input-group-text"><i class="bi bi-qr-code"></i></span>
                        <input asp-for="PatientCode" class="form-control text-uppercase" placeholder="PAT-YYYY-NNNNN" required autocomplete="off" />
                    </div>
                    <span asp-validation-for="PatientCode" class="text-danger small mt-1 d-block"></span>
                </div>
                
                <div class="col-md-6">
                    <label asp-for="FullName" class="form-label text-secondary">Full Name</label>
                    <div class="input-group bps-hospital-input-group">
                        <span class="input-group-text"><i class="bi bi-person-fill"></i></span>
                        <input asp-for="FullName" class="form-control" placeholder="Juan dela Cruz" required autocomplete="name" />
                    </div>
                    <span asp-validation-for="FullName" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Email" class="form-label text-secondary">Email Address</label>
                    <div class="input-group bps-hospital-input-group">
                        <span class="input-group-text"><i class="bi bi-envelope-fill"></i></span>
                        <input asp-for="Email" class="form-control" placeholder="name@example.com" required autocomplete="email" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="ContactNumber" class="form-label text-secondary">Contact Number</label>
                    <div class="input-group bps-hospital-input-group">
                        <span class="input-group-text"><i class="bi bi-telephone-fill"></i></span>
                        <input asp-for="ContactNumber" class="form-control" placeholder="0917 123 4567" autocomplete="tel" />
                    </div>
                    <span asp-validation-for="ContactNumber" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Password" class="form-label text-secondary">Password</label>
                    <div class="input-group bps-hospital-input-group">
                        <span class="input-group-text"><i class="bi bi-key-fill"></i></span>
                        <input asp-for="Password" class="form-control" placeholder="••••••••" required autocomplete="new-password" />
                        <button class="btn bps-toggle-password" type="button" data-password-toggle="Password">
                            <i class="bi bi-eye-slash"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="ConfirmPassword" class="form-label text-secondary">Confirm Password</label>
                    <div class="input-group bps-hospital-input-group">
                        <span class="input-group-text"><i class="bi bi-key-fill"></i></span>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••••" required autocomplete="new-password" />
                        <button class="btn bps-toggle-password" type="button" data-password-toggle="ConfirmPassword">
                            <i class="bi bi-eye-slash"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Birthdate" class="form-label text-secondary">Date of Birth</label>
                    <div class="input-group bps-hospital-input-group">
                        <span class="input-group-text"><i class="bi bi-calendar-event-fill"></i></span>
                        <input asp-for="Birthdate" class="form-control" type="date" required />
                    </div>
                    <span asp-validation-for="Birthdate" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="ProfilePhoto" class="form-label text-secondary">Profile Photo (Optional)</label>
                    <div class="input-group bps-hospital-input-group">
                        <span class="input-group-text"><i class="bi bi-camera-fill"></i></span>
                        <input asp-for="ProfilePhoto" class="form-control" type="file" accept=".jpg,.jpeg,.png" />
                    </div>
                    <span asp-validation-for="ProfilePhoto" class="text-danger small mt-1 d-block"></span>
                </div>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 mb-3">
                Register Account <i class="bi bi-check-circle-fill ms-2"></i>
            </button>
        </form>

        <div class="bps-hospital-footer">
            <p class="mb-1 text-muted">Already have an account?</p>
            <a asp-controller="Account" asp-action="Login">
                Log in instead <i class="bi bi-arrow-right-short"></i>
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
